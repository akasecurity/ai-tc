{
  "specVersion": 1,
  "id": "command-risk/sql-log-webshell",
  "name": "SQL statement that writes a web-executable script file",
  "category": "custom",
  "severity": "high",
  "matcher": {
    "type": "regex",
    "pattern": "\\bSET[ \\t]{1,8}(?:(?:GLOBAL|PERSIST)[ \\t]{1,8}|@@(?:global|persist)\\.)(?:general|slow_query)_log_file[ \\t]{0,8}:?=[ \\t]{0,8}['\"][^'\"\\n]{1,200}\\.(?:jspx?|jspf|php[0-9]?|phtml|pht|phar|asp|aspx|ashx|asmx|cfm|shtml)(?=[ \\t.]{0,8}['\"]|::\\$\\w{0,20}['\"]|;[^'\"/\\\\\\n]{0,200}['\"])|\\bINTO\\s{1,8}(?:OUTFILE|DUMPFILE)\\s{1,8}['\"][^'\"\\n]{1,200}\\.(?:jspx?|jspf|php[0-9]?|phtml|pht|phar|asp|aspx|ashx|asmx|cfm|shtml)(?=[ \\t.]{0,8}['\"]|::\\$\\w{0,20}['\"]|;[^'\"/\\\\\\n]{0,200}['\"])",
    "flags": "gim"
  },
  "examples": [
    "SET GLOBAL general_log_file = '/var/www/html/x1.jsp'",
    "SELECT '<?php system($_GET[0]); ?>' INTO OUTFILE '/var/www/html/s.php'"
  ],
  "appliesTo": {
    "eventKinds": ["tool_use"]
  }
}
