[
  {
    "label": "incident: names-only filter with BSD-unsupported \\s",
    "text": "ssh -o BatchMode=yes example-host 'cd ~; [ -f .zshenv ] && grep -E \"^\\s*export\\s+[A-Za-z_]+=\" .zshenv | sed -E \"s/^\\s*export\\s+([A-Za-z_0-9]+)=.*/\\1/\" | tr \"\\n\" \" \"'",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "grep -n of one name",
    "text": "grep -n NAME ~/.zshenv",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "rg of an env file",
    "text": "rg -n TOKEN deploy/.env",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "jq over credentials json",
    "text": "jq .claudeAiOauth ~/.claude/.credentials.json",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "behind sudo",
    "text": "sudo grep password /root/.aws/credentials",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "count only",
    "text": "grep -c NAME ~/.zshenv",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "quiet test",
    "text": "grep -q NAME ~/.zshenv && echo yes",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "files with matches",
    "text": "rg -l TOKEN .env",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "long count flag",
    "text": "grep --count NAME ~/.zshrc",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "example env",
    "text": "grep NAME .env.example",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "ordinary source search",
    "text": "rg -n 'process.env' src/config.ts",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "pipe boundary",
    "text": "cat build.log | grep .env",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "prose",
    "text": "Never use grep on your .env file in a shared terminal.",
    "shouldMatch": false,
    "eventKind": "tool_use"
  }
]
