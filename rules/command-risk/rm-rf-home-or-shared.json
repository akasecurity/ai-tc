{
  "specVersion": 1,
  "id": "command-risk/rm-rf-home-or-shared",
  "name": "Recursive rm of home, /Users or a system directory",
  "category": "custom",
  "severity": "high",
  "matcher": {
    "type": "regex",
    "pattern": "\\brm(?<=(?:^|[;&|({\\x60]|\\$\\(|(?<![\\w.-])(?:(?:ba|z|da|k)?sh(?:[ \\t]+-[A-Za-z]+){0,2}?[ \\t]+-[A-Za-z]*c|eval|ssh(?:[ \\t]+[^\\s;|&\"'\\x60]{1,200}){1,6}?)[ \\t]+[\"'])[ \\t]*(?:(?:then|do|else|!)[ \\t]+)?(?:[A-Za-z_][A-Za-z0-9_]*=[^\\s;|&]{0,200}[ \\t]+){0,4}(?:(?:sudo|doas|env|command|exec|nohup|nice|time|xargs)(?:[ \\t]+[^\\s;|&\"'\\x60]{1,100}){0,4}?[ \\t]+)?(?:[\\w.~-]*/){0,8}rm)(?:[ \\t]+[^\\s;|&]{1,200}){0,8}?[ \\t]+(?:-[A-Za-z]*[rR][A-Za-z]*|--recursive)(?:[ \\t]+[^\\s;|&]{1,200}){0,8}?[ \\t]+[\"']?(?:~|\\$HOME(?!\\w)|\\$\\{HOME\\}|/(?:Users|home)(?=[/\\s\"';|&)]|$)|/(?:etc|var|usr|bin|sbin|lib|opt|System|Library)?/?\\*?(?=[\\s\"';|&)]|$)|\\.\\.(?:/\\.\\.)*/?(?=[\\s\"';|&)]|$))",
    "flags": "gm"
  },
  "examples": [
    "rm -rf ~/projects/demo-app/$WORKDIR",
    "rm -rf ~/worktrees/x ~/.claude-demo/projects/-Users-x"
  ],
  "appliesTo": {
    "eventKinds": ["tool_use"]
  }
}
