  },
  {
    "label": "subagent prompt naming the host",
    "text": "find any reference to routify-file-proxy-sg in this repo",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "DNS lookup of the file proxy host",
    "text": "nslookup routify-file-proxy-sg.oss-ap-southeast-1.aliyuncs.com",
