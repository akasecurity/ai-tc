{
  "specVersion": 1,
  "id": "secrets/tailscale-key",
  "name": "Tailscale auth/API/client key",
  "category": "secret",
  "severity": "critical",
  "matcher": {
    "type": "regex",
    "pattern": "\\btskey-(?:auth|api|client)-(?![Xx]+-)[A-Za-z0-9]{8,32}-[A-Za-z0-9]{16,64}\\b",
    "flags": "g"
  },
  "examples": [
    "sudo tailscale up --auth-key=tskey-auth-kAb3Xk9QzCNTRL-Ab3Xk9QzAb3Xk9QzAb3Xk9QzAb3Xk9Qz",
    "TS_API_KEY=tskey-api-kEXAMPLE1CNTRL-EXAMPLEEXAMPLEEXAMPLEEXAMPLE12"
  ]
}
