{
  "name": "@akasecurity/ai-tc-claude-code",
  "version": "0.9.16",
  "description": "AI Traffic Control — inspect and govern AI prompts in Claude Code",
  "license": "Apache-2.0",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/akasecurity/ai-tc.git",
    "directory": "plugins/claude-code"
  },
  "homepage": "https://github.com/akasecurity/ai-tc/tree/main/plugins/claude-code",
  "files": [
    ".claude-plugin",
    "hooks",
    "types",
    "commands",
    "scripts"
  ],
  "publishConfig": {
    "registry": "https://registry.npmjs.org",
    "access": "public"
  },
  "scripts": {
    "build": "tsup && node build/engine.mjs",
    "dev": "tsup --watch",
    "lint": "eslint src test eval *.config.*",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prepack": "pnpm run build",
    "test:mod-runtime": "node test/mod-runtime/prepare.mjs && claude plugin test test/mod-runtime"
  },
  "devDependencies": {
    "@akasecurity/detections": "workspace:*",
    "@akasecurity/eslint-config": "workspace:*",
    "@akasecurity/persistence": "workspace:*",
    "@akasecurity/plugin-runtime": "workspace:*",
    "@akasecurity/plugin-sdk": "workspace:*",
    "@akasecurity/scanner": "workspace:*",
    "@akasecurity/schema": "workspace:*",
    "@akasecurity/setup-wizard": "workspace:*",
    "@types/node": "^25.9.9",
    "@vitest/coverage-v8": "^4.1.11",
    "esbuild": "^0.28.2",
    "eslint": "^9.39.5",
    "tsup": "^8.0.0",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11",
    "zod": "^4.6.5"
  }
}
