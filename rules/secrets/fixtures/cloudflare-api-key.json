[
  {
    "label": "Cloudflare API token env var",
    "text": "CLOUDFLARE_API_TOKEN=kQ9fL2mP7xR4tY6wB1nC8vD3jH5sZ0aG2eU4iO7p",
    "shouldMatch": true
  },
  {
    "label": "cloudflare token in YAML",
    "text": "cloudflare_api_token: \"aZ3xQ9wE7rT2yU5iO8pA1sD4fG6hJ0kL2zX5cV8b\"",
    "shouldMatch": true
  },
  {
    "label": "40-char token without Cloudflare context",
    "text": "api_token=kQ9fL2mP7xR4tY6wB1nC8vD3jH5sZ0aG2eU4iO7p",
    "shouldMatch": false
  },
  {
    "label": "too short with context",
    "text": "CLOUDFLARE_API_KEY=12345",
    "shouldMatch": false
  },
  {
    "label": "high-entropy image digest after cloudflared@sha256",
    "text": "image: cloudflare/cloudflared@sha256:5f6522eb83ac110c957c1aa682488f15a9d4bad66c414ccbf66282cb06d73a49",
    "shouldMatch": false
  },
  {
    "label": "high-entropy image digest with a space after the sha256 colon",
    "text": "image: cloudflare/cloudflared@sha256: 5f6522eb83ac110c957c1aa682488f15a9d4bad66c414ccbf66282cb06d73a49",
    "shouldMatch": false
  },
  {
    "label": "high-entropy NEL report URL query value",
    "text": "{\"endpoints\":[{\"url\":\"https://a.nel.cloudflare.com/report/v4?s=5lIAVFS6-dfVdTrUmOITSmSJKw77YYUtoJFybx5N%2FW4\"}]}",
    "shouldMatch": false
  },
  {
    "label": "labeled all-hex token still matches",
    "text": "CLOUDFLARE_API_KEY=15fd022e2a17646fd3a3f20e668fa45c6079ca44",
    "shouldMatch": true
  }
]
