    "eslint-plugin-n": "^18.3.0",
    "eslint-plugin-react": "^7.37.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "typescript-eslint": "^8.67.0"
  },
  "devDependencies": {
    "@types/node": "^25.9.5",
    "@vitest/coverage-v8": "^4.1.10",
    "eslint": "^9.39.5",
    "vitest": "^4.1.10"
  },
  "peerDependencies": {
    "eslint": "^9.39.5",
    "typescript": "^5.0.0"
  }
}
