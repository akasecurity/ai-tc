{
  "specVersion": 1,
  "id": "code-flaws/sql-inject-interp",
  "name": "SQL injection via Ruby string interpolation or PHP variable",
  "category": "code_flaw",
  "severity": "high",
  "matcher": {
    "type": "regex",
    "pattern": "([\"'`])\\s*(?=(?:select\\b(?:(?!\\1)[^\\n])*?\\bfrom\\b|insert\\s+(?:(?:ignore|low_priority|delayed|high_priority|or\\s+\\w+)\\s+){0,2}into\\b|update\\s+(?:(?:low_priority|ignore|or\\s+\\w+)\\s+){0,2}(?:only\\s+)?(?:[\\w.`\\\"$]|#\\{[^}\\n]+\\}|\\{\\$[^}\\n]+\\})+(?:\\s+(?:as\\s+)?(?:[\\w.`\\\"$]|#\\{[^}\\n]+\\}|\\{\\$[^}\\n]+\\})+)?(?:\\s*,\\s*(?:[\\w.`\\\"$]|#\\{[^}\\n]+\\}|\\{\\$[^}\\n]+\\})+(?:\\s+(?:as\\s+)?(?:[\\w.`\\\"$]|#\\{[^}\\n]+\\}|\\{\\$[^}\\n]+\\})+)?){0,7}\\s+set\\s+(?:[\\w.`\\\"$]|#\\{[^}\\n]+\\}|\\{\\$[^}\\n]+\\})+\\s*=|delete\\s+(?:(?:low_priority|quick|ignore)\\s+){0,3}(?:from\\b|[\\w.`]+(?:\\s*,\\s*[\\w.`]+)*\\s+from\\s+[\\w.`]+(?:\\s+(?:as\\s+)?\\w+)?\\s+(?:(?:inner|cross|(?:left|right)(?:\\s+outer)?)\\s+)?(?:join|using|where)\\b)|where\\s+(?:not\\s+)?(?:\\(\\s*)*(?:[\\w.`$]|#\\{[^}\\n]+\\})+\\s*(?:=|<>|!=|<|>|\\b(?:i?like|in|between|is)\\b)))\\b(?:select|insert|update|delete|where)\\b(?:(?!\\1)[^\\n])*?(?:#\\{|\\$[a-z_])|(?<=^|\\n)[ \\t]*(?=(?:select\\b[^\\n]*?\\bfrom\\b|insert\\s+(?:(?:ignore|low_priority|delayed|high_priority|or\\s+\\w+)\\s+){0,2}into\\b|update\\s+(?:(?:low_priority|ignore|or\\s+\\w+)\\s+){0,2}(?:only\\s+)?(?:[\\w.`\\\"$]|#\\{[^}\\n]+\\}|\\{\\$[^}\\n]+\\})+(?:\\s+(?:as\\s+)?(?:[\\w.`\\\"$]|#\\{[^}\\n]+\\}|\\{\\$[^}\\n]+\\})+)?(?:\\s*,\\s*(?:[\\w.`\\\"$]|#\\{[^}\\n]+\\}|\\{\\$[^}\\n]+\\})+(?:\\s+(?:as\\s+)?(?:[\\w.`\\\"$]|#\\{[^}\\n]+\\}|\\{\\$[^}\\n]+\\})+)?){0,7}\\s+set\\s+(?:[\\w.`\\\"$]|#\\{[^}\\n]+\\}|\\{\\$[^}\\n]+\\})+\\s*=|delete\\s+(?:(?:low_priority|quick|ignore)\\s+){0,3}(?:from\\b|[\\w.`]+(?:\\s*,\\s*[\\w.`]+)*\\s+from\\s+[\\w.`]+(?:\\s+(?:as\\s+)?\\w+)?\\s+(?:(?:inner|cross|(?:left|right)(?:\\s+outer)?)\\s+)?(?:join|using|where)\\b)|where\\s+(?:not\\s+)?(?:\\(\\s*)*(?:[\\w.`$]|#\\{[^}\\n]+\\})+\\s*(?:=|<>|!=|<|>|\\b(?:i?like|in|between|is)\\b)))(?:select|insert|update|delete|where)\\s[^\\n]*?(?:#\\{|\\$[a-z_])",
    "flags": "gi"
  },
  "examples": [
    "\"SELECT * FROM users WHERE id = #{params[:id]}\"",
    "\"SELECT * FROM users WHERE id = $userId\""
  ],
  "appliesTo": {
    "extensions": [".rb", ".php"]
  }
}
