[
  {
    "label": "general_log_file pointed at a jsp",
    "text": "mysql -e \"SET GLOBAL general_log_file = '/var/www/html/x1.jsp'\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "INTO OUTFILE to a php path",
    "text": "mysql -e \"SELECT '<?php system($_GET[0]); ?>' INTO OUTFILE '/var/www/html/s.php'\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "INTO DUMPFILE to an aspx path",
    "text": "psql -c \"SELECT 1\" ; mysql -e \"SELECT 1 INTO DUMPFILE 'C:/inetpub/wwwroot/a.aspx'\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "OUTFILE to a phtml path",
    "text": "mysql -e \"SELECT 'x' INTO OUTFILE '/var/www/html/s.phtml'\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "general_log_file to a log path",
    "text": "mysql -e \"SET GLOBAL general_log_file = '/var/log/mysql/general.log'\"",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "INTO OUTFILE to a csv",
    "text": "mysql -e \"SELECT * FROM t INTO OUTFILE '/tmp/export.csv'\"",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "same text in a tool response",
    "text": "SET GLOBAL general_log_file = '/var/www/html/x1.jsp'",
    "shouldMatch": false,
    "eventKind": "response"
  },
  {
    "label": "php extension followed by a backup suffix",
    "text": "mysql -e \"SELECT * FROM t INTO OUTFILE '/tmp/x.php.bak'\"",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "@@global form of general_log_file",
    "text": "mysql -e \"SET @@global.general_log_file = '/var/www/html/x.php'\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "slow_query_log_file pointed at a php path",
    "text": "mysql -e \"SET GLOBAL slow_query_log_file = '/var/www/html/x.php'\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "INTO OUTFILE split across lines",
    "text": "mysql <<SQL\nSELECT 'x' INTO\nOUTFILE '/var/www/html/s.php'\nSQL",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "trailing dot after the extension",
    "text": "mysql -e \"SELECT 'x' INTO OUTFILE 'C:/inetpub/wwwroot/x.aspx.'\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "trailing space after the extension",
    "text": "mysql -e \"SELECT 'x' INTO OUTFILE '/var/www/html/x.php '\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "alternate data stream suffix",
    "text": "mysql -e \"SELECT 'x' INTO OUTFILE 'C:/xampp/htdocs/x.php::$DATA'\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "semicolon before a second extension",
    "text": "mysql -e \"SELECT 'x' INTO OUTFILE '/var/www/html/x.asp;.jpg'\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "directory named like a script",
    "text": "mysql -e \"SELECT 1 INTO OUTFILE '/tmp/reports.php/export.csv'\"",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "script extension inside a longer file name",
    "text": "mysql -e \"SELECT 1 INTO OUTFILE '/tmp/x.php backup.txt'\"",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "semicolon in a directory name",
    "text": "mysql -e \"SELECT 1 INTO OUTFILE '/tmp/reports.php;archive/export.csv'\"",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "stream suffix in a directory name",
    "text": "mysql -e \"SELECT 1 INTO OUTFILE '/tmp/reports.php::$DATA/export.csv'\"",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "long suffix after the semicolon",
    "text": "mysql -e \"SELECT 1 INTO OUTFILE 'C:/inetpub/wwwroot/x.asp;aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa.jpg'\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "nine trailing spaces after the extension",
    "text": "mysql -e \"SELECT 'x' INTO OUTFILE '/var/www/html/x.php         '\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "twelve trailing dots after the extension",
    "text": "mysql -e \"SELECT 'x' INTO OUTFILE 'C:/inetpub/wwwroot/a.aspx............'\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "sixty-four trailing spaces after the extension",
    "text": "mysql -e \"SELECT 'x' INTO OUTFILE '/var/www/html/x.php                                                                '\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "two hundred fifty-six trailing dots after the extension",
    "text": "mysql -e \"SELECT 'x' INTO OUTFILE '/var/www/html/x.php................................................................................................................................................................................................................................................................'\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "padding beyond the bound is not matched",
    "text": "mysql -e \"SELECT 'x' INTO OUTFILE '/var/www/html/x.php............................................................................................................................................................................................................................................................................................................'\"",
    "shouldMatch": false,
    "eventKind": "tool_use"
  }
]
