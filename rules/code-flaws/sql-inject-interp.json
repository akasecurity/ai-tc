{
  "specVersion": 1,
  "id": "code-flaws/sql-inject-interp",
  "name": "SQL injection via Ruby string interpolation or PHP variable",
  "category": "code_flaw",
  "severity": "high",
  "matcher": {
    "type": "regex",
    "pattern": "([\"'`])\\s*\\b(?:select|insert|update|delete|where)\\b(?:(?!\\1)[^\\n])*?(?:#\\{|\\$[a-z_])|(?<=^|\\n)[ \\t]*(?:select|insert|update|delete|where)\\s[^\\n]*?(?:#\\{|\\$[a-z_])",
    "flags": "gi"
  },
  "examples": [
    "\"SELECT * FROM users WHERE id = #{params[:id]}\"",
    "\"SELECT * FROM users WHERE id = $userId\""
  ],
  "appliesTo": {
    "extensions": [".rb", ".php"]
  }
}
