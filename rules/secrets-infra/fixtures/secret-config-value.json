[
  {
    "label": "incident shape: a config file whose only field is a low-entropy password",
    "text": "{\n  \"password\": \"amber-kettle-73\"\n}\n",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 17,
        "end": 32
      }
    ]
  },
  {
    "label": "unknown field name: passphrase nested in a sync block",
    "text": "{\n  \"sync\": {\n    \"server\": \"notes.example.invalid\",\n    \"passphrase\": \"willow-ember-58\"\n  },\n  \"theme\": \"dark\"\n}\n",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 72,
        "end": 87
      }
    ]
  },
  {
    "label": "unknown field name: pairing code, random but under no known prefix",
    "text": "{ \"device\": \"workstation\", \"pairing\": \"Zq81mVtR0aLp44XsYb2NcE7kWd9HfU3o\", \"autostart\": true }",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 39,
        "end": 71
      }
    ]
  },
  {
    "label": "camelCase key: refreshToken",
    "text": "{\"refreshToken\": \"rt-0f9e8d7c6b5a\"}",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 18,
        "end": 33
      }
    ]
  },
  {
    "label": "snake_case key with a prefix: client_secret",
    "text": "\"client_secret\": \"pZ4kQ9wE2rT7yU1i\"",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 18,
        "end": 34
      }
    ]
  },
  {
    "label": "TOML key with a quoted value",
    "text": "[server]\nhost = \"db.example.invalid\"\nadmin_password = \"copper-lantern-19\"\n",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 55,
        "end": 72
      }
    ]
  },
  {
    "label": "YAML key with a bare value",
    "text": "database:\n  user: app\n  db_pass: thistle-harbor-27\n",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 33,
        "end": 50
      }
    ]
  },
  {
    "label": "INI key with a trailing comment",
    "text": "[mail]\nsmtp_pin = 8841 ; the door pin\n",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 18,
        "end": 22
      }
    ]
  },
  {
    "label": "env line: an unknown suffix the env rule does not know",
    "text": "export BACKUP_PASSPHRASE=saffron-meadow-64\n",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 25,
        "end": 42
      }
    ]
  },
  {
    "label": "dotted TOML key",
    "text": "vault.unlock.passcode = \"meadow-falcon-11\"\n",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 25,
        "end": 41
      }
    ]
  },
  {
    "label": "grep -n output of a TOML line",
    "text": "conf/app.toml:12:signing_key = \"Hk3vR8sQ1wN6tZ0b\"\n",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 32,
        "end": 48
      }
    ]
  },
  {
    "label": "a PIN of four digits is still a finding",
    "text": "{\"pin\": \"4417\"}",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 9,
        "end": 13
      }
    ]
  },
  {
    "label": "placeholder: changeme",
    "text": "{\"password\": \"changeme\"}",
    "shouldMatch": false
  },
  {
    "label": "placeholder: your-…-here",
    "text": "API_TOKEN=your-api-token-here\n",
    "shouldMatch": false
  },
  {
    "label": "placeholder: angle brackets",
    "text": "passphrase: <set me>\n",
    "shouldMatch": false
  },
  {
    "label": "placeholder: an environment reference",
    "text": "{\"token\": \"${GITHUB_TOKEN}\"}",
    "shouldMatch": false
  },
  {
    "label": "placeholder: a template reference",
    "text": "token: {{ .Values.token }}\n",
    "shouldMatch": false
  },
  {
    "label": "placeholder: a secret-manager reference",
    "text": "db_password = \"op://vault/item/password\"\n",
    "shouldMatch": false
  },
  {
    "label": "an auth method name, not a credential",
    "text": "{\"auth\": \"oauth2\"}",
    "shouldMatch": false
  },
  {
    "label": "a redacted value is not re-flagged",
    "text": "{\"password\": \"[REDACTED:SECRET]\"}",
    "shouldMatch": false
  },
  {
    "label": "a key whose last segment is not secret-bearing",
    "text": "{\"token_type\": \"bearer-access\", \"password_hash\": \"x9f8e7d6c5b4\", \"max_tokens\": \"4096\"}",
    "shouldMatch": false
  },
  {
    "label": "a secret word inside a longer word",
    "text": "{\"compass\": \"north-by-west\", \"spinner\": \"dots-classic\", \"bypass\": \"allowlist-only\"}",
    "shouldMatch": false
  },
  {
    "label": "a bare key name is not a secret key (key bindings)",
    "text": "{\"key\": \"ctrl+shift+p\", \"command\": \"workbench.action.showCommands\"}",
    "shouldMatch": false
  },
  {
    "label": "TypeScript object literal: unquoted key, value followed by a comma",
    "text": "const fixture = {\n  user: 'test',\n  password: 'hunter2hunter2',\n};\n",
    "shouldMatch": false
  },
  {
    "label": "TypeScript assignment",
    "text": "const password = 'correct-horse-battery';\n",
    "shouldMatch": false
  },
  {
    "label": "a value too short to be a credential",
    "text": "pin = 12\n",
    "shouldMatch": false
  },
  {
    "label": "a boolean",
    "text": "auth: true\n",
    "shouldMatch": false
  },
  {
    "label": "a passphrase that starts with \"!\" is a value, not a reference",
    "text": "{\"passphrase\":\"!S3curePass!\"}",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 15,
        "end": 27
      }
    ]
  },
  {
    "label": "the same value on a TOML line",
    "text": "passphrase = \"!S3curePass!\"\n",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 14,
        "end": 26
      }
    ]
  },
  {
    "label": "a password that starts with \"%\"",
    "text": "db_password: \"%Rk9vQ2wE\"\n",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 14,
        "end": 23
      }
    ]
  },
  {
    "label": "an unquoted numeric PIN in JSON",
    "text": "{\"device\": \"lock\", \"pin\": 4417}",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 26,
        "end": 30
      }
    ]
  },
  {
    "label": "an unquoted numeric pairing code in JSON",
    "text": "{\n  \"pairing_code\": 905531,\n  \"paired\": true\n}",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 20,
        "end": 26
      }
    ]
  },
  {
    "label": "TypeScript interface field typed with a class",
    "text": "interface Session {\n  accessToken: AccessToken;\n}\n",
    "shouldMatch": false
  },
  {
    "label": "Python annotation with a secret type",
    "text": "class Settings(BaseSettings):\n    password: SecretStr\n",
    "shouldMatch": false
  },
  {
    "label": "Python annotation with a builtin type",
    "text": "class Key:\n  secret: bytes\n",
    "shouldMatch": false
  },
  {
    "label": "a version pin",
    "text": "pin: \"3.11\"\n",
    "shouldMatch": false
  },
  {
    "label": "a Python format reference",
    "text": "db_password = \"%(db_password)s\"\n",
    "shouldMatch": false
  },
  {
    "label": "an environment variable reference",
    "text": "token: $GITHUB_TOKEN\n",
    "shouldMatch": false
  },
  {
    "label": "a numeric non-PIN JSON value",
    "text": "{\"token_ttl\": 3600, \"token\": 3600}",
    "shouldMatch": false
  },
  {
    "label": "bearer key in JSON",
    "text": "{\"bearer\": \"a3f9c27d81b4e605d9f2a7c13e8b4056f1d7a29c8e3b60f4d5a1c97e2b8f3d60\"}",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 12,
        "end": 76
      }
    ]
  },
  {
    "label": "bearer key in YAML",
    "text": "auth:\n  bearer: 4gH7jK1lZ5xC8vB2nM6a\n",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 16,
        "end": 36
      }
    ]
  },
  {
    "label": "session_key in JSON",
    "text": "{\"session\": {\"session_key\": \"a3f9c27d81b4e605d9f2a7c13e8b4056f1d7a29c8e3b60f4d5a1c97e2b8f3d60\"}}",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 29,
        "end": 93
      }
    ]
  },
  {
    "label": "camelCase sessionKey",
    "text": "{\"sessionKey\": \"pZ4kQ9wE2rT7yU1iOa3S\"}",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 16,
        "end": 36
      }
    ]
  },
  {
    "label": "dotted TOML session key",
    "text": "auth.session_key = \"meadow-falcon-11-quartz\"\n",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 20,
        "end": 43
      }
    ]
  },
  {
    "label": "env session key",
    "text": "export SESSION_KEY=Zq81mVtR0aLp44XsYb2NcE7k\n",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 19,
        "end": 43
      }
    ]
  },
  {
    "label": "look-alike: session_key_id",
    "text": "{\"session_key_id\": \"0a1b2c3d4e5f6a7b8c9d\"}",
    "shouldMatch": false
  },
  {
    "label": "look-alike: bearer_format",
    "text": "bearer_format: \"JWT-HS256-v1\"",
    "shouldMatch": false
  },
  {
    "label": "bearer flag",
    "text": "{\"bearer\": true}",
    "shouldMatch": false
  },
  {
    "label": "session key from the environment",
    "text": "session_key: ${SESSION_KEY_VALUE}",
    "shouldMatch": false
  }
]
