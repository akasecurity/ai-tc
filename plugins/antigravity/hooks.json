{
  "aka-antigravity": {
    "PreInvocation": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT:-$HOME/.gemini/antigravity-cli/plugins/aka-antigravity}/scripts/pre-invocation.js\" \"${PLUGIN_ROOT:-$HOME/.gemini/antigravity-cli/plugins/aka-antigravity}/plugin.json\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT:-$HOME/.gemini/antigravity-cli/plugins/aka-antigravity}/scripts/pre-tool-use.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": ".*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT:-$HOME/.gemini/antigravity-cli/plugins/aka-antigravity}/scripts/post-tool-use.js\"",
            "timeout": 10
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT:-$HOME/.gemini/antigravity-cli/plugins/aka-antigravity}/scripts/stop.js\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
