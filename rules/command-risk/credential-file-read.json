{
  "specVersion": 1,
  "id": "command-risk/credential-file-read",
  "name": "Dump of a credential-bearing file",
  "category": "custom",
  "severity": "medium",
  "matcher": {
    "type": "regex",
    "pattern": "\\b(?:cat|bat|less|more|head|tail|sed|awk|nl|xxd|strings|base64)[ \\t]+(?:[^\\s;|&]{1,200}[ \\t]+){0,8}?[\"']?(?:[^\\s;|&\"']*/)?(?:\\.env(?!\\.(?:example|sample|template|dist))(?:\\.[A-Za-z0-9_-]+)?|[A-Za-z0-9_-]*\\.env|\\.zshenv|\\.zshrc|\\.zprofile|\\.bashrc|\\.bash_profile|\\.netrc|\\.npmrc|\\.pgpass|[A-Za-z0-9_-]*auth\\.json|\\.?credentials\\.json|id_(?:rsa|ed25519|ecdsa|dsa))(?=$|[\\s\"';|&)])",
    "flags": "gm"
  },
  "examples": ["cat ~/.zshenv", "cat /tmp/host-auth.json"],
  "appliesTo": {
    "eventKinds": ["tool_use"]
  }
}
