    "pattern": "\\b(?=(?:curl\\b(?=(?:[^\\n;|&\\\\]|\\\\[\\s\\S]|&(?!&)){0,400}?(?:(?<=\\s)(?:(?:-[A-Za-z]{0,6}T|--upload-file)(?:[ \\t]+|=)?['\"]?[^\\s'\"]|(?:-[A-Za-z]{0,6}[dF]|--data(?:-binary|-urlencode|-ascii)?|--json|--form)(?:[ \\t]+|=)?['\"]?(?:[\\w.-]{1,64}=)?@)|\\$\\((?:env|printenv)\\b|\\x60(?:env|printenv)\\b))|wget\\b(?=(?:[^\\n;|&\\\\]|\\\\[\\s\\S]|&(?!&)){0,400}?(?:(?<=\\s)(?:--post-file|--body-file)|\\$\\((?:env|printenv)\\b|\\x60(?:env|printenv)\\b))))(?<=(?:^|[;&|({\\x60'\"]|\\$\\()[ \\t]*(?:(?:sudo|doas|command|exec|nohup|time)[ \\t]+(?:-[A-Za-z]{1,8}[ \\t]+){0,3})?(?:[\\w.~-]*/){0,8})(?:curl|wget)\\b(?:[^\\n;|&\\\\]|\\\\[\\s\\S]|&(?!&)){0,400}?(?:(?<![\\w-])[sS]3[\\w-]{0,40}(?:\\.[\\w-]{1,63}){0,3}\\.[aA][mM][aA][zZ][oO][nN][aA][wW][sS]\\.[cC][oO][mM](?:\\.[cC][nN])?|(?:(?<![\\w-])[sS][tT][oO][rR][aA][gG][eE]\\.[gG][oO][oO][gG][lL][eE][aA][pP][iI][sS]|\\.[rR]2\\.[cC][lL][oO][uU][dD][fF][lL][aA][rR][eE][sS][tT][oO][rR][aA][gG][eE]|\\.[aA][lL][iI][yY][uU][nN][cC][sS])\\.[cC][oO][mM]|\\.[bB][lL][oO][bB]\\.[cC][oO][rR][eE]\\.[wW][iI][nN][dD][oO][wW][sS]\\.[nN][eE][tT])(?![\\w-]|\\.[\\w-])|\\b(?=(?:aws|gsutil|gcloud|az)\\b)(?<=(?:^|[;&|({\\x60'\"]|\\$\\()[ \\t]*(?:(?:sudo|doas|command|exec|nohup|time)[ \\t]+(?:-[A-Za-z]{1,8}[ \\t]+){0,3})?(?:[\\w.~-]*/){0,8})(?:(?:aws\\b[^\\n;|&]{0,200}?(?<=\\s)s3[ \\t]+(?:cp|sync)|gsutil\\b[^\\n;|&]{0,200}?(?<=\\s)cp|gcloud\\b[^\\n;|&]{0,200}?(?<=\\s)storage[ \\t]+cp)(?:[ \\t]+(?:-[A-Za-z]{1,8}|--(?:profile|region|acl|exclude|include|project|storage-class)[ \\t]+[^\\s;&|-][^\\s;&|]{0,199}|--(?!(?:profile|region|acl|exclude|include|project|storage-class)(?![\\w-]))[\\w-]{1,40}(?:=[^\\s;&|]{0,200})?)(?=\\s|$)){0,8}[ \\t]+['\"]?(?![A-Za-z][\\w+.-]{0,20}://)(?:-(?=[\\s'\"]|$)|[^\\s;&|'\"-][^\\s;&|]{0,300})(?:[ \\t]+[^\\s;&|]{1,300}){0,8}?[ \\t]+['\"]?(?:s3|gs)://|(?:aws\\b[^\\n;|&]{0,200}?(?<=\\s)s3api[ \\t]+put-object(?![\\w-])[^\\n;|&]{0,400}?(?<=\\s)--body|az\\b[^\\n;|&]{0,200}?(?<=\\s)storage[ \\t]+blob[ \\t]+(?:upload(?![\\w-])[^\\n;|&]{0,400}?(?<=\\s)(?:--file|-f)|upload-batch(?![\\w-])[^\\n;|&]{0,400}?(?<=\\s)(?:--source|-s)))(?:[ \\t]+|=)['\"]?[^\\s'\";|&-])",
    "flags": "gm"
