{
  "specVersion": 1,
  "id": "code-flaws/sql-inject-format",
  "name": "SQL injection via format string or f-string",
  "category": "code_flaw",
  "severity": "high",
  "matcher": {
    "type": "regex",
    "pattern": "\\b(?=(select\\b(?:(?!\\b(?:select\\b|insert\\s+into\\b|update\\s+\\S+\\s+set\\b|delete\\s+from\\b|drop\\s+(?:table|database)\\b))[^\\n])*?\\bfrom\\b|insert\\s+into\\b|update\\s+\\S+\\s+set\\b|delete\\s+from\\b|drop\\s+(?:table|database)\\b))\\1(?:(?!\\b(?:select\\b|insert\\s+into\\b|update\\s+\\S+\\s+set\\b|delete\\s+from\\b|drop\\s+(?:table|database)\\b))[^\\n])*?(?:[%][sd]|\\{[^{}\\n]+\\})|\\b(?=(where\\b(?:(?!\\bwhere\\b)[^\\n])*?=))\\2(?:(?!\\bwhere\\b)[^\\n])*?(?:[%][sd]|\\{[^{}\\n]+\\})",
    "flags": "gi"
  },
  "examples": [
    "f\"SELECT * FROM users WHERE id = {user_id}\"",
    "\"SELECT * FROM users WHERE name = '%s'\" % name"
  ]
}
