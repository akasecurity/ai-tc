[
  {
    "label": "yaml.load without loader",
    "text": "config = yaml.load(user_input)",
    "shouldMatch": true
  },
  {
    "label": "yaml.load with open file no SafeLoader",
    "text": "data = yaml.load(f)",
    "shouldMatch": true
  },
  {
    "label": "yaml.load with SafeLoader",
    "text": "config = yaml.load(data, Loader=yaml.SafeLoader)",
    "shouldMatch": false
  },
  {
    "label": "yaml.safe_load",
    "text": "data = yaml.safe_load(stream)",
    "shouldMatch": false
  },
  {
    "label": "same code in an out-of-scope file (.go) is gated by appliesTo",
    "text": "config = yaml.load(user_input)",
    "shouldMatch": false,
    "filePath": "src/example.go"
  },
  {
    "label": "multi-line call with no Loader",
    "text": "data = yaml.load(\n    stream,\n)",
    "shouldMatch": true
  },
  {
    "label": "multi-line call with SafeLoader",
    "text": "data = yaml.load(\n    stream,\n    Loader=yaml.SafeLoader,\n)",
    "shouldMatch": false
  },
  {
    "label": "outer call whose only SafeLoader belongs to a nested call",
    "text": "config = yaml.load(yaml.load(f, Loader=SafeLoader))",
    "shouldMatch": true
  },
  {
    "label": "two safe calls on one line",
    "text": "a = yaml.load(f, Loader=SafeLoader); b = yaml.load(g, Loader=yaml.SafeLoader)",
    "shouldMatch": false
  }
]
