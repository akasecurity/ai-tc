[
  {
    "label": "API_KEY env",
    "text": "API_KEY=aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 8,
        "end": 44
      }
    ],
    "expectedVariableName": "API_KEY"
  },
  {
    "label": "SECRET env",
    "text": "export SECRET=super-secret-value-12345",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 14,
        "end": 38
      }
    ],
    "expectedVariableName": "SECRET"
  },
  {
    "label": "API_KEY without value",
    "text": "API_KEY=\"sk-...we-should-mask-this\"",
    "shouldMatch": true
  },
  {
    "label": "not sensitive",
    "text": "NAME=John",
    "shouldMatch": false
  },
  {
    "label": "naming convention",
    "text": "THE_API_KEY is configured",
    "shouldMatch": false
  },
  {
    "label": "PRIVATE_KEY env",
    "text": "PRIVATE_KEY=aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890",
    "shouldMatch": true
  },
  {
    "label": "encryption_key env, lowercase",
    "text": "encryption_key=aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890",
    "shouldMatch": true
  },
  {
    "label": "SIGNING_KEY env",
    "text": "export SIGNING_KEY=super-secret-value-12345",
    "shouldMatch": true
  },
  {
    "label": "naming convention, not an assignment",
    "text": "THE_PRIVATE_KEY is rotated automatically",
    "shouldMatch": false
  },
  {
    "label": "unrelated _KEY suffix not in the keyword list",
    "text": "PUBLIC_KEY=aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890",
    "shouldMatch": false
  },
  {
    "label": "exported shell password, value is the span",
    "text": "export PASSWORD=SuperSecret123!",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 16,
        "end": 31
      }
    ],
    "expectedVariableName": "PASSWORD"
  },
  {
    "label": "double-quoted value records the variable name",
    "text": "STRIPE_SECRET_KEY=\"not-a-real-value-1234\"",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 19,
        "end": 40
      }
    ],
    "expectedVariableName": "STRIPE_SECRET_KEY"
  },
  {
    "label": "exported single-quoted value records the variable name",
    "text": "export DB_PASSWORD='not-a-real-value-1234'",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 20,
        "end": 41
      }
    ],
    "expectedVariableName": "DB_PASSWORD"
  },
  {
    "label": "spaces around the equals sign record the variable name",
    "text": "API_TOKEN = not-a-real-value-1234",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 12,
        "end": 33
      }
    ],
    "expectedVariableName": "API_TOKEN"
  },
  {
    "label": "exported, spaced and quoted records the variable name",
    "text": "  export GITHUB_TOKEN = \"not-a-real-value-1234\"",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 25,
        "end": 46
      }
    ],
    "expectedVariableName": "GITHUB_TOKEN"
  },
  {
    "label": "code assignment from a call, not a secret",
    "text": "const token = getToken();",
    "shouldMatch": false
  },
  {
    "label": "code assignment from a property chain, not a secret",
    "text": "secret = config.auth.secret_value",
    "shouldMatch": false
  },
  {
    "label": "shell variable reference, not a secret",
    "text": "export GITHUB_TOKEN=$GH_TOKEN_FROM_VAULT",
    "shouldMatch": false
  },
  {
    "label": "template placeholder, not a secret",
    "text": "API_KEY=${API_KEY_FROM_CI}",
    "shouldMatch": false
  },
  {
    "label": "angle-bracket placeholder, not a secret",
    "text": "PASSWORD=<your-password-here>",
    "shouldMatch": false
  },
  {
    "label": "command substitution, not a secret",
    "text": "TOKEN=$(gh auth token --hostname github.com)",
    "shouldMatch": false
  },
  {
    "label": "boolean literal, not a secret",
    "text": "SECRET=false",
    "shouldMatch": false
  },
  {
    "label": "pass inside another word, not a secret",
    "text": "compass=north-west-1234",
    "shouldMatch": false
  },
  {
    "label": "literal value after a PASS keyword",
    "text": "DB_PASS=Tr0ub4dor3xyz",
    "shouldMatch": true
  },
  {
    "label": "literal token with dots and dashes",
    "text": "export AUTH_TOKEN=abc123.def-456_ghi789",
    "shouldMatch": true
  },
  {
    "label": "bcrypt hash value is a literal, not a shell reference",
    "text": "SECRET=$2a$12$abcdefghijklmnopqrstuvwxyz012345",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 7,
        "end": 46
      }
    ]
  },
  {
    "label": "quoted bcrypt hash value is a literal too",
    "text": "PASSWORD=\"$2b$10$abcdefabcdefabcdefabcdefabcdef\"",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 10,
        "end": 47
      }
    ]
  },
  {
    "label": "KNOWN GAP (PR #714): pure dotted literal — the pattern cannot tell it from a property chain, so it stays undetected by design",
    "text": "ACCESS_TOKEN=abc.def.ghi",
    "shouldMatch": false
  },
  {
    "label": "KNOWN GAP (PR #714): dotted sk.live key — same property-chain indistinguishability, stays undetected by design",
    "text": "API_KEY=sk.live.abcdef1234567890",
    "shouldMatch": false
  },
  {
    "label": "KNOWN GAP (PR #714): dot-separated id/secret pair (Twilio-style) — same, stays undetected by design",
    "text": "TWILIO_TOKEN=abcdef1234567890.abcdef1234567890",
    "shouldMatch": false
  },
  {
    "label": "await keyword is not a value",
    "text": "const token = await getToken();",
    "shouldMatch": false
  },
  {
    "label": "input identifier is not a value",
    "text": "password = input",
    "shouldMatch": false
  },
  {
    "label": "typeof keyword is not a value",
    "text": "const token = typeof x",
    "shouldMatch": false
  },
  {
    "label": "this keyword is not a value",
    "text": "this.secret = this",
    "shouldMatch": false
  },
  {
    "label": "self identifier is not a value",
    "text": "secret = self",
    "shouldMatch": false
  },
  {
    "label": "yield keyword is not a value",
    "text": "const token = yield next",
    "shouldMatch": false
  },
  {
    "label": "keyword prefix of a longer literal is still a value",
    "text": "password=inputXYZ12abc",
    "shouldMatch": true
  },
  {
    "label": "keyword-led literal with a separator is still a value",
    "text": "API_TOKEN=await_9f8e7d6c5b4a",
    "shouldMatch": true
  }
]
