{
  "specVersion": 1,
  "id": "command-risk/git-force-push",
  "name": "git push --force / -f",
  "category": "custom",
  "severity": "high",
  "matcher": {
    "type": "regex",
    "pattern": "\\bgit(?<=(?:^|[;&|({\\x60]|\\$\\(|-[A-Za-z]*c[ \\t]+[\"'])[ \\t]*(?:(?:then|do|else|!)[ \\t]+)?(?:(?:sudo|doas|env|command|exec|nohup|nice|time|xargs)(?:[ \\t]+[^\\s;|&\"'\\x60]{1,100}){0,4}?[ \\t]+)?(?:[\\w.~-]*/){0,8}git)(?:[ \\t]+(?:-[Cc][ \\t]+[^\\s;|&]{1,200}|--[a-z][a-z-]{0,40}(?:=[^\\s;|&]{1,200})?)){0,4}[ \\t]+push(?:[ \\t]+[^\\s;|&]{1,200}){0,8}?[ \\t]+(?:-[A-Za-z]*f[A-Za-z]*|--force(?![\\w-])|\\+[^\\s;|&+]{1,200})(?=[\\s;|&)\"'\\x60]|$)",
    "flags": "gm"
  },
  "examples": ["git push -q -f origin feature-x", "git push --force origin main"],
  "appliesTo": {
    "eventKinds": ["tool_use"]
  }
}
