{
  "specVersion": 1,
  "id": "command-risk",
  "name": "Risky agent commands",
  "version": "0.3.0",
  "defaultPolicy": "warn",
  "rules": [
    "pkill-broad",
    "rm-rf-home-or-shared",
    "git-force-push",
    "git-reset-hard",
    "curl-pipe-shell",
    "credential-file-read",
    "credential-file-grep",
    "credential-file-access",
    "protected-path-access"
  ]
}
