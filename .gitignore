/audit-report.md
/artifact-audit-report.md

# `vitest bench --outputJson`, one per package with a bench/ directory. A
# measurement of the machine it ran on, so it is a workflow artifact rather
# than something to commit.
bench-results.json

# Per-developer Claude Code settings (plugin enablement etc.) stay local.
.claude/settings.local.json

# local agent-tooling state — not product code
.wolf/
.superpowers/

# maintainer-internal docs never ship in the OSS tree (see CLAUDE.md)
docs/

# Claude Code project config stays local — never ship agent-tooling config
.claude/settings.json
.claude/rules/
.worktrees/

# Raw web-chat captures and the sanitiser's survey output. A capture is a real
# conversation — somebody's messages, their account identifiers, their auth
# headers — and a survey file is unpruned strings lifted verbatim out of one.
# Only the sanitised fixture scripts/sanitize-capture.mjs produces is ever
# committed.
#
# Ignored by LOCATION rather than by a name convention nobody is told about:
# everything under the fixtures tree is ignored, and the artifacts the fixture
# bar reads are re-included by name. Anything else landing there — a capture
# saved as capture.json, a survey, a scratch copy — is ignored by default.
*.har
*.raw.json
*.keys.txt
*.values.txt
*.survey.txt
plugins/browser-extension/test/fixtures/**
!plugins/browser-extension/test/fixtures/*/
!plugins/browser-extension/test/fixtures/*/request.json
!plugins/browser-extension/test/fixtures/*/stream.json
!plugins/browser-extension/test/fixtures/*/account.json
!plugins/browser-extension/test/fixtures/*/approved-keys.txt
!plugins/browser-extension/test/fixtures/*/approved-values.txt
