{
  "specVersion": 1,
  "id": "command-risk/protected-path-access",
  "name": "Access to a protected path",
  "category": "custom",
  "severity": "medium",
  "matcher": {
    "type": "regex",
    "pattern": "^protected-path-access:[^\\r\\n]{1,8192}$",
    "flags": "g"
  },
  "examples": ["protected-path-access:/home/agent/Documents/passwords.txt"],
  "appliesTo": {
    "eventKinds": ["tool_use"]
  }
}
