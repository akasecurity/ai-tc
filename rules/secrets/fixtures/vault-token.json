[
  {
    "label": "Vault hvs token",
    "text": "VAULT_TOKEN=hvs.AbCdEfGhIjKlMnOpQrStUvWxYz1234567890",
    "shouldMatch": true
  },
  {
    "label": "Vault s. token",
    "text": "vault_token: s.XyZ1234567890AbCdEfGhIjK",
    "shouldMatch": true
  },
  {
    "label": "not Vault format",
    "text": "token: simple",
    "shouldMatch": false
  },
  {
    "label": "too short",
    "text": "s.short",
    "shouldMatch": false
  },
  {
    "label": "code identifier after s.",
    "text": "return s.validate_python_args_kwargs(args)",
    "shouldMatch": false
  },
  {
    "label": "camelCase property after s.",
    "text": "if (s.watchEveryMinutesMaximum !== undefined)",
    "shouldMatch": false
  },
  {
    "label": "modern service token (hvs. + ~91 chars)",
    "text": "VAULT_TOKEN=hvs.CAESIAb3Xk9Qz7Lm2Pw5Rt8Vy4Nc6Ab3Xk9Qz7Lm2Pw5Rt8Vy4Nc6Ab3Xk9Qz7Lm2Pw5Rt8Vy4Nc6Ab3Xk9Qz7Lm2Pw5Rt8V",
    "shouldMatch": true
  },
  {
    "label": "modern token in a header",
    "text": "X-Vault-Token: hvs.CAESIV8tR5wP2mL7zQ9kX3bA6cN4yV8tR5wP2mL7zQ9kX3bA6cN4yV8tR5wP2mL7zQ9kX3bA6cN4yV8tR5wP2mL7zQ9kX3bA",
    "shouldMatch": true
  },
  {
    "label": "property access inside a call",
    "shouldMatch": false,
    "text": "console.log(JSON.stringify(s.eqLongIdentifierName24Ab, null, 2))"
  },
  {
    "label": "property access inside a template expression",
    "shouldMatch": false,
    "text": "const out = `${s.stallStudyReportTotal24Ab}`;"
  },
  {
    "label": "legacy s. token after a quote",
    "shouldMatch": true,
    "text": "{\"vault_token\": \"s.XyZ1234567890AbCdEfGhIjK\"}"
  },
  {
    "label": "member access after an assignment and a space",
    "shouldMatch": false,
    "text": "const total = s.stallStudyReportTotal24Ab;"
  },
  {
    "label": "member access after return",
    "shouldMatch": false,
    "text": "return s.stallStudyReportTotal24Ab;"
  },
  {
    "label": "legacy s. token after an equals sign with no space",
    "shouldMatch": true,
    "text": "VAULT_TOKEN=s.XyZ1234567890AbCdEfGhIjK"
  },
  {
    "label": "legacy s. body longer than the 24 characters Vault issues",
    "shouldMatch": false,
    "text": "VAULT_TOKEN=s.XyZ1234567890AbCdEfGhIjKl"
  },
  {
    "label": "known gap: a 24-character member access with a digit and a capital still matches",
    "shouldMatch": true,
    "text": "return s.stallStudyReportTotal2Ab;"
  }
]
