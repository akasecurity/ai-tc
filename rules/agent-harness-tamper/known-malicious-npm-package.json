{
  "specVersion": 1,
  "id": "agent-harness-tamper/known-malicious-npm-package",
  "name": "Install of a known malicious npm package",
  "category": "custom",
  "severity": "critical",
  "matcher": {
    "type": "regex",
    "pattern": "\\b(?=(?:npm|pnpm|yarn|bun|npx|bunx)\\b)(?<=(?:^|[;&|({\\x60]|\\$\\(|(?<![\\w.-])(?:ba|z|da|k|fi)?sh(?:[ \\t]+-[A-Za-z]{1,8}){0,3}?[ \\t]+-[A-Za-z]{0,7}c[ \\t]+[\"']|(?<![\\w.-])eval[ \\t]+[\"'])[ \\t]*(?:(?:sudo|doas|env|command|exec|nohup|time|timeout|xargs|setsid)(?:[ \\t]+(?:-[^\\s;|&\"'\\x60]{1,40}|[A-Za-z_]\\w{0,60}=[^\\s;|&\"'\\x60]{0,200}|\\d{1,6}(?:\\.\\d{1,3})?[smhd]?)){0,4}[ \\t]+){0,3}(?:[\\w.~-]*/){0,8})(?:(?:npm|pnpm|bun)[ \\t]+(?:install|i|add|ci)\\b|yarn[ \\t]+add\\b|(?:npx|bunx)[ \\t]+)(?:[^\\n;|&\\\\]|\\\\[\\s\\S]|&(?!&)){0,300}?(?<=[\\s'\"])(?:function-color)(?:@[\\w.^~<>=*-]{1,40})?(?=[\\s'\";|&)]|$)|\"(?:function-color)\"(?<=(?:^\\+?[ \\t]{0,64}|[{,][ \\t\\r\\n]{0,64})\"(?:function-color)\")[ \\t]*:[ \\t]*\"",
    "flags": "gm"
  },
  "examples": ["npm install function-color", "pnpm add function-color@1.0.3"],
  "appliesTo": {
    "eventKinds": ["tool_use", "code_change"]
  }
}
