{
  "specVersion": 1,
  "id": "secrets/vault-token",
  "name": "HashiCorp Vault token",
  "category": "secret",
  "severity": "critical",
  "matcher": {
    "type": "regex",
    "pattern": "\\b(?:hvs\\.[A-Za-z0-9\\-_]{20,200}\\b|(?<![(\\[.{$,])s\\.(?=[A-Za-z0-9]{0,23}\\d)(?=[A-Za-z0-9]{0,23}[A-Z])[A-Za-z0-9]{24}(?![A-Za-z0-9_-]))",
    "flags": "g"
  },
  "postValidators": ["entropy"],
  "examples": ["hvs.AbCdEfGhIjKlMnOpQrStUvWxYz1234567890"]
}
