{
  "specVersion": 1,
  "id": "code-flaws/cmd-inject-node-exec",
  "name": "Command injection via Node.js exec with variable argument",
  "category": "code_flaw",
  "severity": "critical",
  "matcher": {
    "type": "regex",
    "pattern": "(?:\\b(?:child_process|childProcess|cp)\\s*\\??\\.\\s*|\\brequire\\s*\\(\\s*['\"](?:node:)?child_process['\"]\\s*\\)\\s*\\??\\.\\s*|(?<![\\w$.]))(exec(?:Sync)?\\s*\\(\\s*)(?!['\"`])",
    "flags": "g",
    "captureGroup": 1
  },
  "requiresNearby": {
    "labels": ["input", "request", "param", "argv", "user", "query", "body"],
    "windowChars": 200
  },
  "examples": ["exec(req.query.cmd)", "execSync(userInput)"],
  "appliesTo": {
    "extensions": [".js", ".jsx", ".ts", ".tsx", ".mjs", ".cjs"]
  }
}
