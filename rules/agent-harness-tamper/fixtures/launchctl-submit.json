[
  {
    "label": "the planted launchctl submit",
    "text": "launchctl submit -l com.ptools.setup -- /bin/zsh -lc \"mkdir -p /tmp/ptools && cd /tmp/ptools && npm install function-color >/tmp/ptools/ac.log 2>&1\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "behind sudo with a full path",
    "text": "sudo /bin/launchctl submit -l x -- /tmp/run.sh",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "after another command",
    "text": "cd /tmp && launchctl submit -l job -- sh -c id",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "behind sudo and env",
    "text": "sudo env launchctl submit -l x -- /tmp/run.sh",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "behind timeout",
    "text": "timeout 10 launchctl submit -l x -- /tmp/run.sh",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "behind setsid with a full path",
    "text": "setsid /bin/launchctl submit -l x -- /tmp/run.sh",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "listing jobs",
    "text": "launchctl list | grep com.acme",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "printing a service",
    "text": "launchctl print gui/501/com.acme.agent",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "mentioned inside an echo",
    "text": "echo \"prefer a plist over launchctl submit\"",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "listing jobs behind env",
    "text": "env launchctl list",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "quoted in an echo",
    "text": "echo \"launchctl submit is risky\"",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "a grep after env",
    "text": "env | grep \"launchctl submit\"",
    "shouldMatch": false,
    "eventKind": "tool_use"
  }
]
