[
  {
    "label": "API_KEY env",
    "text": "API_KEY=aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 8,
        "end": 44
      }
    ]
  },
  {
    "label": "SECRET env",
    "text": "export SECRET=super-secret-value-12345",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 14,
        "end": 38
      }
    ]
  },
  {
    "label": "API_KEY without value",
    "text": "API_KEY=\"sk-...we-should-mask-this\"",
    "shouldMatch": true
  },
  {
    "label": "not sensitive",
    "text": "NAME=John",
    "shouldMatch": false
  },
  {
    "label": "naming convention",
    "text": "THE_API_KEY is configured",
    "shouldMatch": false
  },
  {
    "label": "PRIVATE_KEY env",
    "text": "PRIVATE_KEY=aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890",
    "shouldMatch": true
  },
  {
    "label": "encryption_key env, lowercase",
    "text": "encryption_key=aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890",
    "shouldMatch": true
  },
  {
    "label": "SIGNING_KEY env",
    "text": "export SIGNING_KEY=super-secret-value-12345",
    "shouldMatch": true
  },
  {
    "label": "naming convention, not an assignment",
    "text": "THE_PRIVATE_KEY is rotated automatically",
    "shouldMatch": false
  },
  {
    "label": "unrelated _KEY suffix not in the keyword list",
    "text": "PUBLIC_KEY=aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890",
    "shouldMatch": false
  },
  {
    "label": "exported shell password, value is the span",
    "text": "export PASSWORD=SuperSecret123!",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 16,
        "end": 31
      }
    ]
  },
  {
    "label": "code assignment from a call, not a secret",
    "text": "const token = getToken();",
    "shouldMatch": false
  },
  {
    "label": "code assignment from a property chain, not a secret",
    "text": "secret = config.auth.secret_value",
    "shouldMatch": false
  },
  {
    "label": "shell variable reference, not a secret",
    "text": "export GITHUB_TOKEN=$GH_TOKEN_FROM_VAULT",
    "shouldMatch": false
  },
  {
    "label": "template placeholder, not a secret",
    "text": "API_KEY=${API_KEY_FROM_CI}",
    "shouldMatch": false
  },
  {
    "label": "angle-bracket placeholder, not a secret",
    "text": "PASSWORD=<your-password-here>",
    "shouldMatch": false
  },
  {
    "label": "command substitution, not a secret",
    "text": "TOKEN=$(gh auth token --hostname github.com)",
    "shouldMatch": false
  },
  {
    "label": "boolean literal, not a secret",
    "text": "SECRET=false",
    "shouldMatch": false
  },
  {
    "label": "pass inside another word, not a secret",
    "text": "compass=north-west-1234",
    "shouldMatch": false
  },
  {
    "label": "literal value after a PASS keyword",
    "text": "DB_PASS=Tr0ub4dor3xyz",
    "shouldMatch": true
  },
  {
    "label": "literal token with dots and dashes",
    "text": "export AUTH_TOKEN=abc123.def-456_ghi789",
    "shouldMatch": true
  }
]
