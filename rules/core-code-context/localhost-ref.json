{
  "specVersion": 1,
  "id": "core-code-context/localhost-ref",
  "name": "Localhost reference",
  "category": "code_context",
  "severity": "low",
  "matcher": {
    "type": "regex",
    "pattern": "(?<![A-Za-z0-9_])(?:localhost|127\\.0\\.0\\.1|0\\.0\\.0\\.0|::1)(?![A-Za-z0-9_])",
    "flags": "g"
  },
  "examples": ["localhost", "127.0.0.1", "0.0.0.0", "::1"]
}
