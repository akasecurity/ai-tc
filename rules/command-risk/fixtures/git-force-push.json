[
  {
    "label": "quiet short flag",
    "text": "git push -q -f origin feature-x",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "long flag",
    "text": "git push --force origin main",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "flag after refspec",
    "text": "git push origin main --force",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "force-with-lease",
    "text": "git push --force-with-lease origin feature-x",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "plain push",
    "text": "git push origin main",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "follow-tags",
    "text": "git push --follow-tags origin main",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "set upstream",
    "text": "git push -u origin feature-x",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "global -C option before push",
    "text": "git -C /tmp/demo-repo push -f",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "global long option before push",
    "text": "git --no-pager push --force origin main",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "plus refspec",
    "text": "git push origin +main",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "plus refspec with source",
    "text": "git push origin +HEAD:main",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "inside sh -c",
    "text": "sh -c \"git push --force origin main\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "absolute path to git",
    "text": "/usr/bin/git push -f",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "prose naming the command",
    "text": "The guide says you must not git push --force on main.",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "echoed text",
    "text": "echo \"git push --force is blocked\"",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "commit message naming the command",
    "text": "git commit -m 'docs: never git push --force'",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "plus inside a branch name",
    "text": "git push origin release+1",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "same command quoted in a tool response is out of scope",
    "text": "git push -q -f origin feature-x",
    "eventKind": "response",
    "shouldMatch": false
  },
  {
    "label": "same command with no capture kind (folder scan) is out of scope",
    "text": "git push -q -f origin feature-x",
    "shouldMatch": false
  },
  {
    "label": "env assignment prefix",
    "text": "GIT_DIR=/x git push --force",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "remote command over ssh",
    "text": "ssh host \"git push --force origin main\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "eval of a quoted command",
    "text": "eval \"git push --force origin main\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "grep -c counting the text is not a shell -c",
    "text": "grep -c \"git push --force\" notes.md",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "bash -lc wrapper",
    "text": "bash -lc 'git push -f origin feature-x'",
    "shouldMatch": true,
    "eventKind": "tool_use"
  }
]
