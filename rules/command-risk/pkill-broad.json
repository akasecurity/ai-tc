{
  "specVersion": 1,
  "id": "command-risk/pkill-broad",
  "name": "pkill -f (command-line pattern kill)",
  "category": "custom",
  "severity": "medium",
  "matcher": {
    "type": "regex",
    "pattern": "\\bpkill(?<=(?:^|[;&|({\\x60]|\\$\\(|(?<![\\w.-])(?:bash|zsh|dash|ksh|csh|tcsh|fish|pwsh|sh)(?:[ \\t]+(?:-[A-Za-z]{1,8}(?:[ \\t]+[^\\s;|&\"'\\x60]{1,100})?|--[a-z][a-z-]{0,40}(?:=[^\\s;|&\"'\\x60]{1,100})?)){0,4}?[ \\t]+-[A-Za-z]*c[ \\t]+[\"']|(?:^|[;&|({\\x60]|\\$\\()[ \\t]*(?:eval(?:[ \\t]+[^\\s;|&\"'\\x60]{1,200}){0,6}?[ \\t]+[\"']|ssh(?:[ \\t]+-[^\\s]+(?:[ \\t]+[^\\s-][^\\s]*)?){0,6}[ \\t]+[^\\s;|&\"'-][^\\s;|&\"']{0,100}[ \\t]+[\"']?))[ \\t]*(?:(?:then|do|else|!)[ \\t]+)?(?:[A-Za-z_][A-Za-z0-9_]*=[^\\s;|&]{0,200}[ \\t]+){0,4}(?:(?:sudo|doas|env|command|exec|nohup|nice|time|xargs)(?:[ \\t]+[^\\s;|&\"'\\x60]{1,100}){0,4}?[ \\t]+)?(?:[\\w.~-]*/){0,8}pkill)(?:[ \\t]+[^\\s;|&]{1,200}){0,8}?[ \\t]+(?:-[A-Za-z0-9]*f[A-Za-z0-9]*|--full)[ \\t]+[\"'\\w]",
    "flags": "gm"
  },
  "examples": ["pkill -f \"Brave Browser\"", "pkill -TERM -f \"bun src/main.ts\""],
  "appliesTo": {
    "eventKinds": ["tool_use"]
  }
}
