  },
  {
    "label": "sh -c wrapper",
    "text": "sh -c \"cat ~/.aws/credentials\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "bash -lc wrapper",
    "text": "bash -lc 'cat ~/.zshenv'",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "fish -c wrapper",
    "text": "fish -c \"cat ~/.aws/credentials\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "tcsh -c wrapper",
    "text": "tcsh -c 'cat ~/.zshenv'",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "pwsh -c wrapper",
    "text": "pwsh -c \"cat ~/.aws/credentials\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "bash with valued short flag",
    "text": "bash -o pipefail -c \"cat ~/.aws/credentials\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "bash with long flag",
    "text": "bash --norc -c \"cat ~/.aws/credentials\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "echoed eval mention",
    "text": "echo 'eval \"cat ~/.zshenv\"'",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "echoed ssh mention",
    "text": "echo 'ssh host \"cat ~/.aws/credentials\"'",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "grep of an eval mention",
    "text": "grep -n 'eval \"cat ~/.zshenv\"' script.sh",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "commit message naming an eval",
    "text": "git commit -m 'warning: eval \"cat ~/.zshenv\" is dangerous'",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "wish is not a shell",
    "text": "wish -c \"cat ~/.aws/credentials\"",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "ssh quoted remote sed on zshenv",
    "text": "ssh example-host 'sed -n 1,3p ~/.zshenv'",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "ssh unquoted remote cat on zshenv",
    "text": "ssh -o BatchMode=yes example-host cat ~/.zshenv",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "ssh remote grep count only",
    "text": "ssh example-host 'grep -c CLAUDE_CODE ~/.zshenv'",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "ssh after a separator, not only at the line start",
    "text": "cd /tmp && ssh example-host 'cat ~/.env'",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "quoted prose naming the ssh spelling",
    "text": "echo ssh example-host 'cat ~/.env'",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "commit message naming the ssh spelling",
    "text": "git commit -m \"ssh example-host 'cat ~/.env'\"",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "prose with a colon before the ssh spelling",
    "text": "echo \"to read it: ssh example-host 'tail ~/.npmrc'\"",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "seven ssh option groups — past the deliberate {0,6} cap, so no match",
    "text": "ssh -o A=1 -o B=2 -o C=3 -o D=4 -o E=5 -o F=6 -o G=7 example-host cat ~/.zshenv",
    "shouldMatch": false,
    "eventKind": "tool_use"
  }
