[
  {
    "label": "the package named in the attack",
    "text": "mkdir -p /tmp/ptools && cd /tmp/ptools && npm install function-color >/tmp/ptools/ac.log 2>&1",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "pinned with pnpm",
    "text": "pnpm add function-color@1.0.3",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "run through npx",
    "text": "npx -y function-color",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "added to package.json",
    "text": "\"dependencies\": {\n    \"function-color\": \"^1.0.0\"\n  }",
    "shouldMatch": true,
    "eventKind": "code_change",
    "filePath": "/w/package.json"
  },
  {
    "label": "added with yarn",
    "text": "yarn add function-color",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "run through bunx",
    "text": "bunx function-color",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "added to package.json in a diff",
    "text": " \"dependencies\": {\n+    \"function-color\": \"^1.0.0\",\n     \"lodash\": \"^4.17.21\"\n   }",
    "shouldMatch": true,
    "eventKind": "code_change",
    "filePath": "/w/package.json"
  },
  {
    "label": "an ordinary package install",
    "text": "npm install lodash",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "a package whose name only contains it",
    "text": "npm install function-color-utils",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "mentioned in an echo",
    "text": "echo \"do not install function-color\"",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "uninstalled with npm",
    "text": "npm uninstall function-color",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "removed with npm",
    "text": "npm remove function-color",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "removed with pnpm",
    "text": "pnpm remove function-color",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "looked up with npm view",
    "text": "npm view function-color version",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "queried with yarn why",
    "text": "yarn why function-color",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "the install command quoted in an echo",
    "text": "echo \"npm install function-color\"",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "removed from package.json in a diff",
    "text": " \"dependencies\": {\n-    \"function-color\": \"^1.0.0\",\n     \"lodash\": \"^4.17.21\"\n   }",
    "shouldMatch": false,
    "eventKind": "code_change",
    "filePath": "/w/package.json"
  }
]
