{
  "specVersion": 1,
  "id": "command-risk/credential-file-read",
  "name": "Dump of a credential-bearing file",
  "category": "custom",
  "severity": "medium",
  "matcher": {
    "type": "regex",
    "pattern": "\\b(?:cat|bat|less|more|head|tail|sed|awk|nl|xxd|strings|base64)(?<=(?:^|[;&|({\\x60]|\\$\\(|(?<![\\w.-])(?:(?:ba|z|da|k)?sh(?:[ \\t]+-[A-Za-z]+){0,2}?[ \\t]+-[A-Za-z]*c|eval|ssh(?:[ \\t]+[^\\s;|&\"'\\x60]{1,200}){1,6}?)[ \\t]+[\"'])[ \\t]*(?:(?:then|do|else|!)[ \\t]+)?(?:[A-Za-z_][A-Za-z0-9_]*=[^\\s;|&]{0,200}[ \\t]+){0,4}(?:(?:sudo|doas|env|command|exec|nohup|nice|time|xargs)(?:[ \\t]+[^\\s;|&\"'\\x60]{1,100}){0,4}?[ \\t]+)?(?:[\\w.~-]*/){0,8}(?:cat|bat|less|more|head|tail|sed|awk|nl|xxd|strings|base64))[ \\t]+(?:[^\\s;|&]{1,200}[ \\t]+){0,8}?[\"']?(?:[^\\s;|&\"']*/)?(?:\\.env(?!\\.(?:example|sample|template|dist))(?:\\.[A-Za-z0-9_-]+)?|[A-Za-z0-9_-]*\\.env|\\.zshenv|\\.zshrc|\\.zprofile|\\.bashrc|\\.bash_profile|\\.netrc|\\.npmrc|\\.pgpass|\\.git-credentials|\\.aws/(?:credentials|config)|(?:[A-Za-z0-9_.-]*[_.-])?auth\\.json|\\.?credentials\\.json|id_(?:rsa|ed25519|ecdsa|dsa))(?=$|[\\s\"';|&)])",
    "flags": "gm"
  },
  "examples": ["cat ~/.zshenv", "cat /tmp/host-auth.json"],
  "appliesTo": {
    "eventKinds": ["tool_use"]
  }
}
