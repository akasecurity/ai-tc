{
  "$schema": "https://turbo.build/schema.json",
  "ui": "tui",
  // test/setup/** is the no-network guard every package loads as a vitest
  // setupFile. It lives outside every package, so nothing would otherwise put it
  // in a `test` task's hash — weakening or deleting it would leave every package
  // replaying a cached green produced under the OLD guard, which is a false
  // green for the guarantee it exists to enforce.
  //
  // test/helpers/** is there for the same reason: teardowns across the workspace
  // import removeTree/removeTrees, whose retry and win32 tolerance no call site
  // can observe, so weakening it would otherwise leave every one of them
  // replaying a cached green taken under the old rule.
  //
  // test/fixtures/** is the third, and it is the one "fixtures are just test
  // data" talks you out of. The adversarial corpus under
  // test/fixtures/adversarial/hostile-repo/ GENERATES the trees the walkers have
  // to survive — symlink loops, `..`-bearing names, nesting past what a path can
  // address, 500k ignored files — and the suites that drive it live in other
  // packages. Weaken a shape (shrink the tree, drop the loop, break the deep
  // chain) and every one of those suites reports green WITHOUT EXECUTING,
  // because turbo hands back a result computed under the OLD fixture. That is
  // the guard silently ceasing to guard at the one moment it is being changed.
  //
  // test/vitest/** is the fourth, and the sharpest of them: it holds the shared
  // coverage block AND every package's coverage FLOOR. A floor is a threshold
  // the package's own test run enforces, so lowering one — or widening an
  // exclude so a file stops counting — changes what `test` is allowed to pass
  // with. Outside the hash, every package would go on replaying a cached green
  // taken under the STRICTER rule, which is a false green for the one thing a
  // floor exists to prevent.
  "globalDependencies": [
    "tsconfig.base.json",
    "rules/**",
    "test/setup/**",
    "test/helpers/**",
    "test/fixtures/**",
    "test/vitest/**"
  ],
  "tasks": {
    // `native-host/**` is plugins/browser-extension's tsup outDir. An output a
    // package writes but does not declare is not restored on a cache hit, so a
    // fresh checkout leaves it missing and an existing checkout keeps whatever
    // stale copy is on disk — which bundle-extension.mjs would then ship into
    // the npm tarball and the SEA binary. Declared for the same reason
    // `scripts/**` is (plugins/claude-code's generated hooks).
    "build": {
      "dependsOn": ["^build", "^typecheck"],
      "outputs": [
        "dist/**",
        "public/**",
        "scripts/**",
        "native-host/**",
        ".next/**",
        "!.next/cache/**"
      ]
    },
    "dev": {
      "dependsOn": ["^build"],
      "persistent": true,
      "cache": false
    },
    "lint": {
      "dependsOn": ["^lint"]
    },
    "typecheck": {
      "dependsOn": ["^typecheck"]
    },
    // `env` is part of the hash, and this entry is the only reason the Windows
    // leg's installer coverage is real. AKA_INSTALLER_ALLOW_USER_PATH switches
    // on the install.ps1 cases that write HKCU's `Path`; turbo hashes only the
    // env it is told about, so without this line a run WITH the variable set
    // hash-matches a cached run without it and replays a green in which those
    // cases skipped. Undeclared, the variable would silently buy nothing.
    // `passThroughEnv` reaches the task WITHOUT entering the hash, which is the
    // right side of that line for an ambient platform fact: every name below
    // describes the RUNNER, so hashing one would fork the cache per machine
    // while answering no question about the inputs.
    //
    // turbo's env mode is `strict`. Its default passthrough already carries
    // PATH, HOME, TEMP, TMP and PATHEXT — so those need no entry here, and
    // adding one would only read as though it bought something. None of the
    // names below are in it, and each is one a Windows child genuinely needs:
    //
    //   PROCESSOR_ARCHITECTURE  install.ps1 reads it at step 1 to pick its
    //                           target triple. Filtered, the child sees an
    //                           empty string and the script correctly refuses
    //                           an architecture it was never told — a refusal
    //                           that reads like a script bug and is not one.
    //   SystemRoot, windir,     Windows PowerShell derives its DEFAULT module
    //   ComSpec, SystemDrive    path from %SystemRoot%, and this suite drops
    //                           PSModulePath on purpose so each edition
    //                           computes its own. Filtered, that derivation has
    //                           nothing to work from and the child loses its
    //                           standard library, Compress-Archive included.
    //   LOCALAPPDATA            install.ps1's default install dir when
    //                           AKA_INSTALL_DIR is unset.
    "test": {
      "dependsOn": ["build", "^build", "^typecheck"],
      "env": ["AKA_INSTALLER_ALLOW_USER_PATH"],
      "passThroughEnv": [
        "PROCESSOR_ARCHITECTURE",
        "SystemRoot",
        "windir",
        "ComSpec",
        "SystemDrive",
        "LOCALAPPDATA"
      ],
      "outputs": ["coverage/**"]
    },
    // Benchmarks, run by the nightly `.github/workflows/bench.yml` and by hand.
    //
    // What it must NOT become is a PR gate: hosted runners vary by a large
    // factor on neighbour load alone, a flaky gate is one people learn to re-run
    // until green, and an ignored gate is worth less than none.
    //
    // `test/performance/` is where the properties that must HOLD live, and it
    // gates without contradicting the line above, because what it asserts is not
    // a wall clock: it compares one cost against itself at two store sizes, and
    // a ratio cancels the runner. The one absolute millisecond bound left there
    // is a gross-regression backstop four orders of magnitude clear of the
    // measurement, for the constant-factor case a ratio cannot see. An absolute
    // bound tight enough to be interesting is exactly what does not survive
    // here — that shape was tried, and a preempted sample on a shared runner
    // reddened a healthy tree.
    //
    // Whether a workflow runs this is a claim about a SIBLING file, and a stale
    // justification reads exactly like a live one — three branches carried three
    // different answers to it at once, all of them green, because the task body
    // is byte-identical whichever comment sits above it. So it is not left to
    // this comment: `bench-harness.test.js` reads bench.yml's schedule and this
    // sentence together and fails when they disagree, in either direction.
    //
    // `cache: false` is the load-bearing line. Every other task here derives its
    // output from its inputs, which is what makes replaying one sound; a
    // benchmark returns a MEASUREMENT, and the machine it ran on — its load, its
    // CPU, its disk — is in none of the hashes. A cache hit would hand the trend
    // another runner's number, taken at another moment, and label it this run's.
    // It is the one stale green that cannot be spotted by reading the result,
    // because the result looks exactly right.
    //
    // No `outputs` here, deliberately. Turbo consults it only to decide what to
    // save into and restore from the cache, so on a never-cached task it does
    // nothing while reading as if the file were tracked somewhere — the opposite
    // of the line above it. Where `bench-results.json` lands is stated by the
    // thing that collects it: `bench.yml`'s upload glob.
    //
    // `dependsOn: build` is there for the benchmarks that measure a BUNDLED
    // artifact rather than source — where the two differ by enough that a run
    // against an unbuilt tree would track a number no user pays. It costs the
    // source-only benchmarks nothing: turbo skips a package with no build task.
    "bench": {
      "dependsOn": ["build", "^build", "^typecheck"],
      "cache": false
    },
    // manifest.test.ts asserts two cross-package invariants by reading the CLI's
    // source as text: the native-host name, and that EXTENSION_IDS grants the id
    // manifest.json's "key" derives. Chrome refuses connectNative for an origin
    // the host manifest omits, so a CLI-side drift is a silent runtime failure
    // rather than a build one — this suite is the only thing that catches it.
    //
    // plugins/browser-extension does not depend on cli, so nothing under cli/ is
    // in the default hash. Measured: swapping the CLI's id for a different
    // well-formed one left the task hash byte-identical, and ci.yml restores
    // .turbo/cache with restore-keys that fall back across commits — so a
    // follow-up touching only the CLI would replay a cached pass and neither
    // guard would execute. Same hazard as the eslint-config entry below, same
    // remedy: name the cross-package file the suite reads.
    //
    // turbo.json is named too, so this entry covers the config that declares it:
    // removing these inputs re-hashes the task, which re-runs the suite, whose
    // own turbo-inputs case then fails rather than going quietly stale.
    "@akasecurity/plugin-browser-extension#test": {
      "dependsOn": ["build", "^build", "^typecheck"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/cli/src/commands/extension.ts",
        "$TURBO_ROOT$/turbo.json"
      ]
    },
    // The eslint-config suite asserts a workspace-wide invariant: every package
    // ships an eslint.config.mjs wiring the no-network ban, points its `lint`
    // script at every directory it holds code in, and covers scripts/ with a
    // second pass. Its default inputs cover only packages/eslint-config/**, and
    // the package has no workspace dependencies — so ADDING A PACKAGE (or a new
    // source directory) ANYWHERE ELSE leaves the task hash untouched and turbo
    // replays a cached pass, which is exactly the moment the guard exists to
    // fire. A stale hit here is a false-green CI for the no-network guarantee.
    //
    // So the inputs mirror everything the suite reads: the manifest, every
    // package.json and eslint config, every lintable source file in the
    // workspace (the suite derives each package's code directories from them),
    // the CI workflow plus the egress-blocking script it drives, and the repo-root
    // manifest, tsconfig, `eslint.root*.config.mjs` behind
    // `lint:root`/`typecheck:root` (the opt-out audit reads those configs) plus
    // every OTHER lintable file at the repo root. Those last six are the subtlest
    // entries here and the reason to be careful with this list: the suite asserts
    // that ci.yml still runs the No-network job, and
    // ci.yml is in no package. Without it, DELETING THAT JOB leaves this task's
    // hash untouched, turbo replays the cached pass, and the assertion guarding the
    // job never runs — the one job that would have re-run it from scratch being the
    // job that was deleted. The repo-root glob is the same hazard for ADDING
    // rather than deleting: the two per-package globs above both require a
    // directory segment, so a new lintable file at the repo root — the one place
    // a file belongs to no workspace package — would leave this hash untouched
    // and the check that names it as unlinted would never run. No repo-root file
    // — package.json, tsconfig.root.json, an eslint.root config, or a new
    // root-level source — is hashed by turbo's per-package globs on its own;
    // each was measured, not assumed.

    // Explicit input globs are NOT filtered by .gitignore, so generated trees
    // are excluded by hand — without that, node_modules alone adds ~23k files to
    // the hash and every install perturbs it. This trades cache hits for
    // correctness: the suite runs in ~1s, and a guard that does not run is worth
    // nothing. The exclusion list has to track the tree's .gitignore files; a
    // generated path that slips through costs a cache miss (a build-output file
    // enters the hash), never a false pass.
    "@akasecurity/eslint-config#test": {
      "dependsOn": ["build", "^build", "^typecheck"],
      "outputs": ["coverage/**"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/pnpm-workspace.yaml",
        "$TURBO_ROOT$/*/package.json",
        "$TURBO_ROOT$/*/eslint*.config.mjs",
        "$TURBO_ROOT$/*/*/package.json",
        "$TURBO_ROOT$/*/*/eslint*.config.mjs",
        "$TURBO_ROOT$/*/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        "$TURBO_ROOT$/*/*/**/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        // EVERY workflow is read by this suite, so this is a glob rather than a
        // list. Named individually, the entries were ci.yml (the repo-root
        // lint/typecheck passes and the egress script), audit.yml and codeql.yml
        // (required-checks.test.js, which drives every job name and PR trigger
        // behind a required check), and bench.yml (bench-harness.test.js, which
        // asserts the benchmark job stays ADVISORY). ci-test-concurrency.test.js
        // now reads the whole directory, because an unbounded `turbo run test`
        // is the same hazard in a release workflow as in ci.yml — and four of
        // those gate a publish on tag push.
        //
        // A glob USED to be wrong here for a good reason: an unread workflow in
        // this directory would bust the hash on every edit. That reason is gone
        // precisely because nothing here is unread any more, which makes this
        // entry and that suite's directory read one decision in two files. A
        // future suite that narrows back to a filename has to narrow this too,
        // or the cost returns. The hazard in the other direction is the one that
        // matters: a workflow this suite reads and turbo does not hash moves no
        // hash on the edit the guard exists to catch, so turbo replays a cached
        // green and the assertion never runs.
        "$TURBO_ROOT$/.github/workflows/*.yml",
        "$TURBO_ROOT$/tools/ci/**",
        "$TURBO_ROOT$/package.json",
        // THIS file is read by coverage-config.test.js, which asserts that the
        // `test` task still declares `coverage/**` and that the shared coverage
        // module is still in globalDependencies. Both live here, so without this
        // entry the two edits that break them — deleting the output declaration,
        // dropping the module out of the hash — would move no hash at all, and
        // turbo would replay a cached green at the one moment those assertions
        // exist to fire. Same hazard the CLAUDE.md and workflow entries carry:
        // no extension glob above reaches a .json at the repo root.
        "$TURBO_ROOT$/turbo.json",
        "$TURBO_ROOT$/tsconfig.root.json",
        "$TURBO_ROOT$/eslint.root*.config.mjs",
        "$TURBO_ROOT$/*.{ts,tsx,mts,cts,js,jsx,mjs,cjs}",
        // CLAUDE.md is READ by this suite: §3's process.env table and §4's
        // no-network opt-out table are each parsed and asserted against the tree
        // they describe. Every other entry here is source; this one is prose,
        // which is exactly why it is easy to leave out — and leaving it out is
        // the whole hazard, because editing only the document would move no hash
        // and turbo would replay a cached green at the one moment the guard
        // exists to fire. No extension glob above reaches a .md.
        "$TURBO_ROOT$/CLAUDE.md",
        // CONTRIBUTING.md the same way: required-checks.test.js parses its
        // "Checks that gate `main`" table and drives every row against the
        // workflows.
        //
        // And EVERY other tracked .md for the same reason one step wider:
        // bench-harness.test.js reads prose across the whole tree, not two named
        // documents, looking for a claim that a human is the only thing running
        // the benchmarks. Naming only the two above would hash the two files
        // least likely to be the one that drifts — the claim that motivated that
        // guard was written in a .ts comment, and the next one is as likely to
        // land in a README or a SKILL.md. A guard whose reach is the tree needs a
        // cache key that is the tree.
        "$TURBO_ROOT$/CONTRIBUTING.md",
        "$TURBO_ROOT$/**/*.md",
        // The same reach for the other two kinds that scan reads. `#` opens a
        // comment in YAML and `//` does in JSONC, so a claim can be written in
        // either — and measured, neither was hashed: editing .github/dependabot.yml,
        // cli/sea-config.json or a package tsconfig.json moved this task's hash not
        // at all while cli/README.md moved it. Covering only .md would have left
        // two thirds of the scan's own surface behind a cached green.
        //
        // Spelled as three globs rather than one brace list on purpose: the
        // extension-completeness guard in effective-config.test.js requires every
        // BRACE glob here to carry the full lintable-source alphabet, which is the
        // right rule for a source glob and the wrong one for these. Keeping them
        // brace-free states that they hash prose, not source, and leaves that
        // guard at full strength.
        "$TURBO_ROOT$/**/*.json",
        "$TURBO_ROOT$/**/*.yml",
        "$TURBO_ROOT$/**/*.yaml",
        "!$TURBO_ROOT$/**/node_modules/**",
        "!$TURBO_ROOT$/**/.next/**",
        "!$TURBO_ROOT$/**/dist/**",
        "!$TURBO_ROOT$/**/coverage/**",
        "!$TURBO_ROOT$/**/dist-sea/**",
        "!$TURBO_ROOT$/**/sea-dist/**",
        "!$TURBO_ROOT$/web-ui/out/**",
        "!$TURBO_ROOT$/web-ui/next-env.d.ts",
        "!$TURBO_ROOT$/cli/web-ui/**",
        "!$TURBO_ROOT$/plugins/claude-code/scripts/**",
        // plugins/browser-extension's tsup outDir, and the copies of it that
        // cli/scripts/bundle-extension.mjs stages into the CLI package. All
        // three are generated and gitignored, and none is named `dist`, so the
        // blanket dist exclusion above does not reach them — without these the
        // .js they emit lands in this hash and every extension build perturbs it.
        "!$TURBO_ROOT$/plugins/browser-extension/native-host/**",
        "!$TURBO_ROOT$/cli/extension/**",
        "!$TURBO_ROOT$/cli/native-host/**"
      ]
    },
    // Three more suites read a file outside their own package, and each one is
    // the same hazard as the CLAUDE.md entry below: a guard that reads a
    // document is defeated by a cache that does not hash it. Editing only the
    // document moves no hash, turbo replays a cached green, and the assertion
    // never runs at the one moment it exists to fire. `$TURBO_DEFAULT$` keeps
    // the package's own tree in the hash — `inputs` REPLACES the default rather
    // than extending it, so dropping that entry would hash the doc and nothing
    // else.
    //
    // audit-gate's suite parses the mute claim out of both documents and drives
    // it against the real gate. That claim was FALSE in a shipped release and
    // nothing caught it, which is the entire reason the guard exists.
    "@akasecurity/audit-gate#test": {
      "dependsOn": ["build", "^build", "^typecheck"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/CLAUDE.md", "$TURBO_ROOT$/CONTRIBUTING.md"]
    },
    // required-checks-gate parses CONTRIBUTING.md's gate table, including the
    // Enforced column its whole job compares against.
    "@akasecurity/required-checks-gate#test": {
      "dependsOn": ["build", "^build", "^typecheck"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/CONTRIBUTING.md"]
    },
    // codeql-alerts-gate reads the baseline it gates on, and asserts its
    // per-severity counts add up to its total — the one check that catches a
    // half-finished hand edit, which is exactly the edit this file invites.
    "@akasecurity/codeql-alerts-gate#test": {
      "dependsOn": ["build", "^build", "^typecheck"],
      "outputs": ["coverage/**"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/.github/codeql-alert-baseline.json"]
    },
    "clean": {
      "cache": false
    }
  }
}
