{
  "specVersion": 1,
  "id": "code-flaws/sql-inject-interp",
  "name": "SQL injection via Ruby string interpolation or PHP variable",
  "category": "code_flaw",
  "severity": "high",
  "matcher": {
    "type": "regex",
    "pattern": "([\"'`])\\s*(?=(?:select\\b(?:(?!\\1)[^\\n])*?\\bfrom\\b|insert\\s+into\\b|update\\s+\\S+\\s+set\\b|delete\\s+from\\b|where\\s+[\\w.`$]+\\s*(?:=|<>|!=|<|>|\\blike\\b|\\bin\\b)))\\b(?:select|insert|update|delete|where)\\b(?:(?!\\1)[^\\n])*?(?:#\\{|\\$[a-z_])|(?<=^|\\n)[ \\t]*(?=(?:select\\b[^\\n]*?\\bfrom\\b|insert\\s+into\\b|update\\s+\\S+\\s+set\\b|delete\\s+from\\b|where\\s+[\\w.`$]+\\s*(?:=|<>|!=|<|>|\\blike\\b|\\bin\\b)))(?:select|insert|update|delete|where)\\s[^\\n]*?(?:#\\{|\\$[a-z_])",
    "flags": "gi"
  },
  "examples": [
    "\"SELECT * FROM users WHERE id = #{params[:id]}\"",
    "\"SELECT * FROM users WHERE id = $userId\""
  ],
  "appliesTo": {
    "extensions": [".rb", ".php"]
  }
}
