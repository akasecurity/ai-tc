[
  {
    "label": "zshenv",
    "text": "cat ~/.zshenv",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "auth json in tmp",
    "text": "cat /tmp/host-auth.json",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "deploy run.env",
    "text": "cat deploy/vm/run.env",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "sed range on zshrc",
    "text": "sed -n '1,20p' ~/.zshrc",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "dotenv variant",
    "text": "tail -n 5 .env.production",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "example env",
    "text": "cat deploy.example.env",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "dotenv example suffix",
    "text": "cat .env.example",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "grep of one name",
    "text": "grep -n NAME ~/.zshenv",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "readme",
    "text": "cat README.md",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "pipe boundary",
    "text": "cat build.log | grep .env",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "prose",
    "text": "Put secrets in your .env file and never commit it.",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "aws credentials file",
    "text": "cat ~/.aws/credentials",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "aws config file",
    "text": "cat ~/.aws/config",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "GNU long flag before the file",
    "text": "head --lines=5 .env",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "behind sudo",
    "text": "sudo cat /root/.aws/credentials",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "inside a command substitution",
    "text": "TOKEN=$(cat .env)",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "git credential store",
    "text": "less ~/.git-credentials",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "oauth client file is not an auth store",
    "text": "cat test/oauth.json",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "prefixed oauth client file",
    "text": "cat config/google-oauth.json",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "aws config backup name",
    "text": "cat ~/.aws/config.bak",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "prose naming the command",
    "text": "Run cat ~/.zshenv to see the values.",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "same command quoted in a tool response is out of scope",
    "text": "cat ~/.zshenv",
    "eventKind": "response",
    "shouldMatch": false
  },
  {
    "label": "same command with no capture kind (folder scan) is out of scope",
    "text": "cat ~/.zshenv",
    "shouldMatch": false
