{
  "name": "ai-tc",
  "private": true,
  "version": "0.8.1",
  "packageManager": "pnpm@10.30.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "lint:root": "eslint --no-config-lookup -c eslint.root.config.mjs test/setup tools/ci *.config.* && eslint --no-config-lookup -c eslint.root.guard.config.mjs packages/eslint-config/test",
    "typecheck": "turbo run typecheck",
    "typecheck:root": "tsc --noEmit -p tsconfig.root.json",
    "test": "turbo run test",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "pnpm install && lefthook install"
  },
  "devDependencies": {
    "@akasecurity/eslint-config": "workspace:*",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@types/node": "^24.13.3",
    "eslint": "^9.0.0",
    "lefthook": "^2.1.10",
    "prettier": "^3.9.6",
    "turbo": "^2.10.7",
    "typescript": "^5.8.0",
    "vitest": "^4.1.10"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.16",
      "brace-expansion@5": "^5.0.8",
      "esbuild": "^0.28.1",
      "fast-uri": "^3.1.4",
      "js-yaml": "^4.3.0",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0"
    }
  }
}
