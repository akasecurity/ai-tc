{
  "specVersion": 1,
  "id": "command-risk/object-storage-upload",
  "name": "Upload to a cloud object storage host",
  "category": "custom",
  "severity": "high",
  "matcher": {
    "type": "regex",
    "pattern": "\\b(?=(?:curl\\b(?=(?:[^\\n;|&\\\\]|\\\\[\\s\\S]|&(?!&)){0,400}?(?<=\\s)(?:-[A-Za-z]{0,6}[dFT]|-X[ \\t]*['\"]?(?:PUT|POST|PATCH)\\b|--request[ \\t=]+['\"]?(?:PUT|POST|PATCH)\\b|--data(?:-binary|-raw|-urlencode|-ascii)?|--json|--form(?:-string)?|--upload-file)(?=[\\s'\"=@]|$))(?!(?:[^\\n;|&\\\\]|\\\\[\\s\\S]|&(?!&)){0,400}?(?:(?<=\\s)(?:(?:-[A-Za-z]{0,6}T|--upload-file)(?:[ \\t]+|=)?['\"]?[^\\s'\"]|(?:-[A-Za-z]{0,6}[dF]|--data(?:-binary|-urlencode|-ascii)?|--json|--form)(?:[ \\t]+|=)?['\"]?(?:[\\w.-]{1,64}=)?@)|\\$\\((?:env|printenv)\\b|\\x60(?:env|printenv)\\b))|wget\\b(?=(?:[^\\n;|&\\\\]|\\\\[\\s\\S]|&(?!&)){0,400}?(?<=\\s)(?:--method[ \\t=]+['\"]?(?:PUT|POST|PATCH)\\b|--post-data|--post-file|--body-data|--body-file))(?!(?:[^\\n;|&\\\\]|\\\\[\\s\\S]|&(?!&)){0,400}?(?:(?<=\\s)(?:--post-file|--body-file)|\\$\\((?:env|printenv)\\b|\\x60(?:env|printenv)\\b))))(?<=(?:^|[;&|({\\x60'\"]|\\$\\()[ \\t]*(?:(?:sudo|doas|command|exec|nohup|time)[ \\t]+(?:-[A-Za-z]{1,8}[ \\t]+){0,3})?(?:[\\w.~-]*/){0,8})(?:curl|wget)\\b(?:[^\\n;|&\\\\]|\\\\[\\s\\S]|&(?!&)){0,400}?(?:(?<![\\w-])[sS]3[\\w-]{0,40}(?:\\.[\\w-]{1,63}){0,3}\\.[aA][mM][aA][zZ][oO][nN][aA][wW][sS]\\.[cC][oO][mM](?:\\.[cC][nN])?|(?:(?<![\\w-])[sS][tT][oO][rR][aA][gG][eE]\\.[gG][oO][oO][gG][lL][eE][aA][pP][iI][sS]|\\.[rR]2\\.[cC][lL][oO][uU][dD][fF][lL][aA][rR][eE][sS][tT][oO][rR][aA][gG][eE]|\\.[aA][lL][iI][yY][uU][nN][cC][sS])\\.[cC][oO][mM]|\\.[bB][lL][oO][bB]\\.[cC][oO][rR][eE]\\.[wW][iI][nN][dD][oO][wW][sS]\\.[nN][eE][tT])(?![\\w-]|\\.[\\w-])|\\b(?=(?:aws|az)\\b)(?<=(?:^|[;&|({\\x60'\"]|\\$\\()[ \\t]*(?:(?:sudo|doas|command|exec|nohup|time)[ \\t]+(?:-[A-Za-z]{1,8}[ \\t]+){0,3})?(?:[\\w.~-]*/){0,8})(?:aws\\b[^\\n;|&]{0,200}?(?<=\\s)s3api[ \\t]+put-object(?![\\w-])(?![^\\n;|&]{0,400}?(?<=\\s)--body(?![\\w-]))|az\\b[^\\n;|&]{0,200}?(?<=\\s)storage[ \\t]+blob[ \\t]+upload(?![\\w-])(?![^\\n;|&]{0,400}?(?<=\\s)(?:--file|-f)(?![\\w-]))[^\\n;|&]{0,400}?(?<=\\s)--data(?![\\w-]))",
    "flags": "gm"
  },
  "examples": [
    "curl -s -X PUT --data-binary \"PROBE\" https://bucket.oss-cn-beijing.aliyuncs.com/upload/test.bin",
    "curl -X POST -d \"status=ok\" https://my-bucket.s3.amazonaws.com/report"
  ],
  "appliesTo": {
    "eventKinds": ["tool_use"]
  }
}
