{
  "specVersion": 1,
  "id": "command-risk/credential-file-access",
  "name": "Read of a credential-bearing file",
  "category": "custom",
  "severity": "medium",
  "matcher": {
    "type": "regex",
    "pattern": "^[ \\t]*[\\\"']?(?![^\\r\\n]*[\\\\/](?:tests?|__tests__|fixtures?|__fixtures__|testdata|spec|examples?|samples?)[\\\\/])(?:(?:[A-Za-z]:|~|\\.{1,2}|[^\\s\\\\/\\\"']{1,255})?[\\\\/](?:[^\\r\\n]{0,4096}[\\\\/])?)?(?:\\.env(?:\\.(?!(?:example|sample|template|dist|defaults?|schema|tpl)(?:[\\\"'\\s]|$))[A-Za-z0-9_-]+)?|[A-Za-z0-9_-]+\\.env|[._]netrc|\\.pgpass|\\.git-credentials|\\.?credentials(?:\\.[A-Za-z0-9]+)?|(?:[A-Za-z0-9_.-]*[_.-])?auth\\.json|\\.ssh[\\\\/]id_[A-Za-z0-9_-]+(?:\\.(?!pub(?:[\\\"'\\s]|$))[A-Za-z0-9_-]+)?|id_(?:rsa|dsa|ecdsa|ed25519)(?:_sk)?)[\\\"']?[ \\t]*$",
    "flags": "gi"
  },
  "examples": ["/home/agent/.ssh/id_ed25519", "/srv/app/.env.production"],
  "appliesTo": {
    "eventKinds": ["tool_use"]
  }
}
