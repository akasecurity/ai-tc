{
  "specVersion": 1,
  "id": "code-flaws/sql-inject-concat-dot",
  "name": "SQL injection via string concatenation (PHP dot operator)",
  "category": "code_flaw",
  "severity": "high",
  "matcher": {
    "type": "regex",
    "pattern": "([\"'])(?=((?:(?!\\1)[^\\n])*?\\b(?:select\\b(?:(?!\\1|\\bselect\\b)[^\\n])*?\\bfrom\\b|insert\\s+into\\b|update\\s+\\S+\\s+set\\b|delete\\s+from\\b|drop\\s+(?:table|database)\\b|where\\s+[\\w.`\\[\\]]+\\s*=)))\\2(?:(?!\\1(?:(?!\\1)[^\\n])*?\\b(?:select\\b|insert\\s+into\\b|update\\s+\\S+\\s+set\\b|delete\\s+from\\b|drop\\s+(?:table|database)\\b|where\\b))[^\\n])*?[\"']\\s*\\.",
    "flags": "gi"
  },
  "appliesTo": {
    "extensions": [".php"]
  },
  "examples": ["$query = \"SELECT * FROM orders WHERE user = \" . $username;"]
}
