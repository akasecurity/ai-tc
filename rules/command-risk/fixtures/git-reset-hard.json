[
  {
    "label": "rewind one commit",
    "text": "git reset --hard HEAD~1",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "chained after cd",
    "text": "cd /tmp/demo-repo && git reset --hard origin/main",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "on its own line of a script",
    "text": "set -e\ngit fetch -q\ngit reset --hard FETCH_HEAD",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "soft reset",
    "text": "git reset --soft HEAD~1",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "markdown doc string",
    "text": "Never run git reset --hard in a shared worktree; use git switch instead.",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "json doc string",
    "text": "{\"note\": \"do not use git reset --hard here\"}",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "echoed text",
    "text": "echo \"git reset --hard is blocked by policy\"",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "inside sh -c",
    "text": "sh -c \"git reset --hard origin/main\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "inside a function body",
    "text": "f() { git reset --hard; }",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "global -C option before reset",
    "text": "git -C /tmp/demo-repo reset --hard",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "mixed reset with -C",
    "text": "git -C /tmp/demo-repo reset --mixed HEAD~1",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "same command quoted in a tool response is out of scope",
    "text": "git reset --hard HEAD~1",
    "eventKind": "response",
    "shouldMatch": false
  },
  {
    "label": "same command with no capture kind (folder scan) is out of scope",
    "text": "git reset --hard HEAD~1",
    "shouldMatch": false
  },
  {
    "label": "env assignment prefix",
    "text": "GIT_DIR=/x git reset --hard HEAD~1",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "remote command over ssh",
    "text": "ssh host \"git reset --hard origin/main\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "eval of a quoted command",
    "text": "eval \"git reset --hard HEAD\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "rg -c counting the text is not a shell -c",
    "text": "rg -c 'git reset --hard' docs/",
    "shouldMatch": false,
    "eventKind": "tool_use"
  }
]
