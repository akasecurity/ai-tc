{
  "specVersion": 1,
  "id": "secrets-infra/env-key-value",
  "name": "Environment variable assignment with sensitive key",
  "category": "secret",
  "severity": "high",
  "matcher": {
    "type": "regex",
    "pattern": "\\b[A-Za-z0-9_]*(?:API_KEY|API_SECRET|SECRET_KEY|SECRET|TOKEN|PASSWORD|(?<![A-Za-z])PASS|CREDENTIALS|PRIVATE_KEY|ENCRYPTION_KEY|SIGNING_KEY)\\s*=\\s*[\"']?(?!\\$(?!2[aby]\\$|argon2id?\\$))(?![()<>{}\\[\\]`%\\\\|;,*])(?!(?:true|false|null|none|nil|undefined|yes|no|on|off|bearer|basic|string|required|changeme|redacted|example)(?![A-Za-z0-9_]))(?![A-Za-z_]\\w*(?:\\.[A-Za-z_]\\w*)+(?![\\w.+/=-]))(?![^\\s\"']*[()\\[\\]{}`])([^\\s\"'()\\[\\]{}`;]{4,})",
    "flags": "gi",
    "captureGroup": 1
  },
  "examples": ["API_KEY=aBcDeFgHiJkLmNoPqRsTuVwXyZ1234567890"]
}
