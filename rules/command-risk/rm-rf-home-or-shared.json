{
  "specVersion": 1,
  "id": "command-risk/rm-rf-home-or-shared",
  "name": "Recursive rm of home, /Users or a system directory itself",
  "category": "custom",
  "severity": "high",
  "matcher": {
    "type": "regex",
    "pattern": "\\brm(?<=(?:^|[;&|({\\x60]|\\$\\(|(?<![\\w.-])(?:bash|zsh|dash|ksh|csh|tcsh|fish|pwsh|sh)(?:[ \\t]+(?:-[A-Za-z]{1,8}(?:[ \\t]+[^\\s;|&\"'\\x60]{1,100})?|--[a-z][a-z-]{0,40}(?:=[^\\s;|&\"'\\x60]{1,100})?)){0,4}?[ \\t]+-[A-Za-z]*c[ \\t]+[\"']|(?:^|[;&|({\\x60]|\\$\\()[ \\t]*(?:eval(?:[ \\t]+[^\\s;|&\"'\\x60]{1,200}){0,6}?[ \\t]+[\"']|ssh(?:[ \\t]+-[^\\s]+(?:[ \\t]+[^\\s-][^\\s]*)?){0,6}[ \\t]+[^\\s;|&\"'-][^\\s;|&\"']{0,100}[ \\t]+[\"']?))[ \\t]*(?:(?:then|do|else|!)[ \\t]+)?(?:[A-Za-z_][A-Za-z0-9_]*=[^\\s;|&]{0,200}[ \\t]+){0,4}(?:(?:sudo|doas|env|command|exec|nohup|nice|time|xargs)(?:[ \\t]+[^\\s;|&\"'\\x60]{1,100}){0,4}?[ \\t]+)?(?:[\\w.~-]*/){0,8}rm)(?:[ \\t]+[^\\s;|&]{1,200}){0,8}?[ \\t]+(?:-[A-Za-z]*[rR][A-Za-z]*|--recursive)(?:[ \\t]+[^\\s;|&]{1,200}){0,8}?[ \\t]+[\"']?(?:~|\\$HOME(?!\\w)|\\$\\{HOME\\}|/(?:Users|home)(?=[/\\s\"';|&)]|$)|/(?:etc|var|usr|bin|sbin|lib|opt|System|Library)?/?\\*?(?=[\\s\"';|&)]|$)|\\.\\.(?:/\\.\\.)*/?(?=[\\s\"';|&)]|$))",
    "flags": "gm"
  },
  "examples": [
    "rm -rf ~/projects/demo-app/$WORKDIR",
    "rm -rf ~/worktrees/x ~/.claude-demo/projects/-Users-x"
  ],
  "appliesTo": {
    "eventKinds": ["tool_use"]
  }
}
