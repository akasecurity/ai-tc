{
  "specVersion": 1,
  "id": "agent-harness-tamper/agent-approval-bypass",
  "name": "Agent CLI run with approvals or sandbox switched off",
  "category": "custom",
  "severity": "critical",
  "matcher": {
    "type": "regex",
    "pattern": "\\b(?=(?:codex|claude|gemini|cursor-agent|opencode|amp)\\b)(?<=(?:^|[;&|({\\x60]|\\$\\(|(?<![\\w.-])(?:ba|z|da|k|fi)?sh(?:[ \\t]+-[A-Za-z]{1,8}){0,3}?[ \\t]+-[A-Za-z]{0,7}c[ \\t]+[\"']|(?<![\\w.-])eval[ \\t]+[\"'])[ \\t]*(?:(?:sudo|doas|env|command|exec|nohup|time|timeout|xargs|setsid)(?:[ \\t]+(?:-[^\\s;|&\"'\\x60]{1,40}|[A-Za-z_]\\w{0,60}=[^\\s;|&\"'\\x60]{0,200}|\\d{1,6}(?:\\.\\d{1,3})?[smhd]?)){0,4}[ \\t]+){0,3}(?:[\\w.~-]*/){0,8})(?:codex|claude|gemini|cursor-agent|opencode|amp)\\b(?:[^\\n;|&\\\\]|\\\\[\\s\\S]|&(?!&)){0,400}?(?<=\\s)(?:--dangerously-bypass-approvals-and-sandbox|--dangerously-skip-permissions|--yolo|--approval-mode(?:[ \\t]+|=)[\"']?yolo|--permission-mode(?:[ \\t]+|=)[\"']?bypassPermissions|(?:--sandbox(?:[ \\t]+|=)|-s[ \\t]+)[\"']?danger-full-access)(?![\\w-])",
    "flags": "gm"
  },
  "examples": [
    "(cd /tmp && codex exec --dangerously-bypass-approvals-and-sandbox --skip-git-repo-check \"confirm the project-tools server initialized\")",
    "claude -p \"fix the build\" --dangerously-skip-permissions"
  ],
  "appliesTo": {
    "eventKinds": ["tool_use"]
  }
}
