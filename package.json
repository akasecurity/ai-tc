{
  "name": "ai-tc",
  "private": true,
  "version": "0.8.1",
  "packageManager": "pnpm@10.30.1",
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint && pnpm lint:root && pnpm check:portability",
    "lint:root": "eslint --no-config-lookup -c eslint.root.config.mjs test/setup test/fixtures test/helpers test/vitest tools/ci *.config.*",
    "check:portability": "node tools/portability-gate/src/check-portability.ts",
    "check:diff-coverage": "node tools/coverage-gate/src/check-diff-coverage.ts",
    "typecheck": "turbo run typecheck && pnpm typecheck:root",
    "typecheck:root": "tsc --noEmit -p tsconfig.root.json",
    "test": "turbo run test",
    "bench": "turbo run bench",
    "clean": "turbo run clean && rm -rf node_modules",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "setup": "pnpm install && lefthook install"
  },
  "devDependencies": {
    "@akasecurity/eslint-config": "workspace:*",
    "@commitlint/cli": "^21.2.2",
    "@commitlint/config-conventional": "^21.2.2",
    "@types/node": "^24.13.3",
    "eslint": "^9.39.5",
    "lefthook": "^2.1.12",
    "prettier": "^3.9.6",
    "turbo": "^2.10.12",
    "typescript": "^5.8.0",
    "vitest": "^4.1.11"
  },
  "pnpm": {
    "overrides": {
      "brace-expansion@1": "^1.1.18",
      "brace-expansion@5": "^5.0.9",
      "browserslist": "^4.28.7",
      "esbuild": "^0.28.2",
      "fast-uri": "^3.1.6",
      "js-yaml": "^4.3.1",
      "nanoid": "^3.3.17",
      "postcss": "^8.5.18",
      "sharp": "^0.35.0"
    }
  }
}
