    "pattern": "(?<![\\w.-])(?!sanmaohe\\.)(?!routify-file-proxy-sg\\.)(?:[\\w-]{1,63}\\.)?oss-[\\w-]{1,40}\\.aliyuncs\\.com(?![\\w-]|\\.[\\w-])(?!(?<=\\bcurl\\b(?:[^\\n;|&\\\\]|\\\\[\\s\\S]|&(?!&)){0,400})(?:(?<=(?:(?<=\\s)(?:-[A-Za-z]{0,6}[dFT]|-X[ \\t]*['\"]?(?:PUT|POST|PATCH)\\b|--request[ \\t=]+['\"]?(?:PUT|POST|PATCH)\\b|--data(?:-binary|-raw|-urlencode|-ascii)?|--json|--form(?:-string)?|--upload-file)(?=[\\s'\"=@]|$)|\\$\\((?:env|printenv)\\b|\\x60(?:env|printenv)\\b)(?:[^\\n;|&\\\\]|\\\\[\\s\\S]|&(?!&)){0,400})|(?:[^\\n;|&\\\\]|\\\\[\\s\\S]|&(?!&)){0,400}?(?:(?<=\\s)(?:-[A-Za-z]{0,6}[dFT]|-X[ \\t]*['\"]?(?:PUT|POST|PATCH)\\b|--request[ \\t=]+['\"]?(?:PUT|POST|PATCH)\\b|--data(?:-binary|-raw|-urlencode|-ascii)?|--json|--form(?:-string)?|--upload-file)(?=[\\s'\"=@]|$)|\\$\\((?:env|printenv)\\b|\\x60(?:env|printenv)\\b)))(?!(?<=\\bwget\\b(?:[^\\n;|&\\\\]|\\\\[\\s\\S]|&(?!&)){0,400})(?:(?<=(?:(?<=\\s)(?:--method[ \\t=]+['\"]?(?:PUT|POST|PATCH)\\b|--post-data|--post-file|--body-data|--body-file)|\\$\\((?:env|printenv)\\b|\\x60(?:env|printenv)\\b)(?:[^\\n;|&\\\\]|\\\\[\\s\\S]|&(?!&)){0,400})|(?:[^\\n;|&\\\\]|\\\\[\\s\\S]|&(?!&)){0,400}?(?:(?<=\\s)(?:--method[ \\t=]+['\"]?(?:PUT|POST|PATCH)\\b|--post-data|--post-file|--body-data|--body-file)|\\$\\((?:env|printenv)\\b|\\x60(?:env|printenv)\\b)))",
    "flags": "g"
  },
  "examples": [
    "curl -s https://some-bucket.oss-cn-hangzhou.aliyuncs.com/a.txt",
