[
  {
    "label": "Ruby string interpolation in SELECT",
    "text": "query = \"SELECT * FROM users WHERE id = #{params[:id]}\"",
    "shouldMatch": true
  },
  {
    "label": "PHP variable in WHERE clause",
    "text": "$sql = \"SELECT * FROM users WHERE name = '$username'\";",
    "shouldMatch": true
  },
  {
    "label": "Ruby safe parameterized query",
    "text": "User.where('id = ?', params[:id])",
    "shouldMatch": false
  },
  {
    "label": "PHP PDO prepared statement",
    "text": "$stmt = $pdo->prepare('SELECT * FROM users WHERE id = :id');",
    "shouldMatch": false
  },
  {
    "label": "same code in an out-of-scope file (.go) is gated by appliesTo",
    "text": "query = \"SELECT * FROM users WHERE id = #{params[:id]}\"",
    "shouldMatch": false,
    "filePath": "src/example.go"
  },
  {
    "label": "PHP variables in two WHERE conditions",
    "text": "$sql = \"SELECT * FROM users WHERE id = $id AND name = '$name'\";",
    "shouldMatch": true
  },
  {
    "label": "JSON array of quoted SQL words with no interpolation",
    "text": "[\"select 1\",\"insert 2\",\"update 3\",\"delete 4\",\"where 5\"]",
    "shouldMatch": false
  },
  {
    "label": "shell command with a SQL word in an argument and a shell variable",
    "text": "tool jobs update-oidc $P",
    "shouldMatch": false,
    "filePath": "src/run.php"
  },
  {
    "label": "shell echo with a hyphenated SQL word and a shell variable",
    "text": "echo \"auto-update is $STATE\"",
    "shouldMatch": false,
    "filePath": "src/run.php"
  },
  {
    "label": "Ruby interpolation in an UPDATE string",
    "text": "q = \"UPDATE users SET name = '#{name}' WHERE id = 1\"",
    "shouldMatch": true
  }
]
