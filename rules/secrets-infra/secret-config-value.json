{
  "specVersion": 1,
  "id": "secrets-infra/secret-config-value",
  "name": "Value under a secret-named config key",
  "category": "secret",
  "severity": "high",
  "matcher": {
    "type": "regex",
    "pattern": "(?:\"(?:[A-Za-z0-9]{1,32}[_.-]){0,3}(?:access|refresh|api|auth|bearer|session|client|app|bot|admin|user|db|root|smtp|mail|login|account|master|private|signing|encryption|device|sync|wifi|vault)?(?:pass(?:word|wd|phrase|code)?|pwd|secret|token|pin(?:[_-]?code)?|pairing(?:[_-]?code)?|credentials?|auth|api[_-]?key|(?:private|secret|access|signing|encryption|master|auth|license)[_-]?key)\"[ \\t]*:[ \\t]*(?=\")|\"(?:[A-Za-z0-9]{1,32}[_.-]){0,3}(?:pin(?:[_-]?code)?|pass[_-]?code|pairing(?:[_-]?code)?)\"[ \\t]*:[ \\t]*(?=[0-9]{4,12}[ \\t]*[,}\\r\\n])|^(?:[^\\r\\n]{1,512}?:\\d{1,9}[:-])?[ \\t]*(?:-[ \\t]+)?(?:export[ \\t]+)?[\"']?(?:[A-Za-z0-9]{1,32}[_.-]){0,3}(?:access|refresh|api|auth|bearer|session|client|app|bot|admin|user|db|root|smtp|mail|login|account|master|private|signing|encryption|device|sync|wifi|vault)?(?:pass(?:word|wd|phrase|code)?|pwd|secret|token|pin(?:[_-]?code)?|pairing(?:[_-]?code)?|credentials?|auth|api[_-]?key|(?:private|secret|access|signing|encryption|master|auth|license)[_-]?key)[\"']?[ \\t]*[:=][ \\t]*(?=(?:\"[^\"\\r\\n]{4,256}\"|'[^'\\r\\n]{4,256}'|[^\\s\"'#;,{}\\[\\]]{4,256})(?:[ \\t]+[#;][^\\r\\n]*)?[ \\t]*\\r?$))(?![\"']?(?:changeme|change[_-]me|password|passwd|secret|token|example|sample|placeholder|redacted|null|nil|none|true|false|yes|no|required|optional|string|test|dummy|fake|todo|tbd|unset|empty|default|basic|bearer|oauth2?|sso|saml|ldap|jwt|kerberos|ntlm|digest|mtls|include|omit|same-origin|anonymous|str|bytes|int|float|bool|number|any|unknown|object|secretstr|secretbytes|buffer|v?\\d+(?:\\.\\d+){1,3}|x{3,}|\\*{3,}|\\.{3,})[\"']?[ \\t]*(?:[,}\\]#;]|\\r?$)|[\"']?(?:\\$[A-Za-z_{(]|%\\(|<[^>\\r\\n]{1,200}>|\\{\\{|\\[REDACTED|\\[\\[aka:|~/|/|your[-_ ]|insert[-_ ]|enter[-_ ]|replace[-_ ]|(?:env|op|vault|keychain|file|secret|ref):)|[\"']?[^\"'\\r\\n]{0,200}[-_ ]here[\"']?[ \\t]*(?:[,}\\]#;]|\\r?$))[\"']?((?<=\")(?:[^\"\\\\\\r\\n]|\\\\.){4,256}(?=\")|(?<=')[^'\\r\\n]{4,256}(?=')|(?<![\"'])[^\\s\"'#;,{}\\[\\]]{4,256})",
    "flags": "gim",
    "captureGroup": 1
  },
  "examples": [
    "\"passphrase\": \"amber-kettle-73\"",
    "pairing_code = \"Zq81mVtR0aLp44XsYb2NcE7kWd9HfU3o\""
  ]
}
