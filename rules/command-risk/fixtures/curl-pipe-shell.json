    "eventKind": "tool_use"
  },
  {
    "label": "pipe to shuf",
    "text": "curl -s https://example.dev/words.txt | shuf -n 3",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "prose",
