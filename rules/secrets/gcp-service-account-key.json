{
  "specVersion": 1,
  "id": "secrets/gcp-service-account-key",
  "name": "GCP service account key file",
  "category": "secret",
  "severity": "critical",
  "matcher": {
    "type": "regex",
    "pattern": "\"private_key_id\"\\s*:\\s*\"([a-f0-9]{40})\"",
    "flags": "g",
    "captureGroup": 1
  },
  "requiresNearby": {
    "labels": ["service_account", "client_email"],
    "windowChars": 400
  },
  "examples": [
    "{\"type\": \"service_account\", \"project_id\": \"sample-project\", \"private_key_id\": \"0a1b2c3d0a1b2c3d0a1b2c3d0a1b2c3d0a1b2c3d\"}"
  ]
}
