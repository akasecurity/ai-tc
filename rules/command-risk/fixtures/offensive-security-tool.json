[
  {
    "label": "impacket secretsdump wrapper",
    "text": "impacket-secretsdump -just-dc corp.example/admin@dc01.example",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "sqlmap against a URL",
    "text": "sqlmap -u \"https://shop.example/item?id=1\" --batch",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "hydra against ssh",
    "text": "hydra -l admin -P pw.txt ssh://host.example",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "mimikatz after sudo with a path",
    "text": "sudo ./mimikatz.exe \"lsadump::dcsync /user:krbtgt\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "Invoke-Kerberoast in a pwsh command",
    "text": "pwsh -c \"Invoke-Kerberoast | Out-File hashes.txt\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "crackmapexec inside bash -c",
    "text": "bash -c 'crackmapexec smb 10.0.0.0/24 -u u -p p'",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "nxc, the netexec short name",
    "text": "nxc smb 10.0.0.0/24 -u a -p b",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "evil-winrm session",
    "text": "evil-winrm -i 10.0.0.5 -u admin -p pw",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "impacket script run through python",
    "text": "python3 /opt/impacket/examples/GetUserSPNs.py corp.example/user:pw -request",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "install of the package, not a run",
    "text": "pip install impacket",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "searching for the name",
    "text": "rg -n hydra README.md",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "which lookup",
    "text": "which sqlmap",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "echo of a tool name",
    "text": "echo mimikatz is flagged by every scanner",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "unrelated hydra-named package path",
    "text": "npm ls hydra-core",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "same command in a tool response",
    "text": "sqlmap -u \"https://shop.example/item?id=1\" --batch",
    "shouldMatch": false,
    "eventKind": "response"
  },
  {
    "label": "Ory Hydra OAuth server subcommand",
    "text": "hydra serve all --dev",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "Medusa e-commerce CLI subcommand",
    "text": "medusa develop",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "script inside a directory named hydra",
    "text": "./hydra/run.sh",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "impacket psexec script run directly",
    "text": "./psexec.py corp.example/admin@10.0.0.5",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "sqlmap from a git clone through python",
    "text": "python3 /opt/sqlmap/sqlmap.py -u \"https://shop.example/item?id=1\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "mimikatz ticket export module",
    "text": "mimikatz.exe \"sekurlsa::tickets /export\"",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "Sysinternals PsExec is not impacket",
    "text": "psexec \\\\\\\\host cmd",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "hydra with a scheme target first",
    "text": "hydra ssh://10.0.0.5 -l admin -P pw.txt",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "hydra with a quoted scheme target",
    "text": "hydra \"ssh://10.0.0.5\" -l admin -P pw.txt",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "hydra web-form module target",
    "text": "hydra https-post-form://host.example/login:u=^USER^:F=bad -l a -P p",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "hydra with an IPv4 target first",
    "text": "hydra 10.0.0.5 ssh -l root -P pw.txt",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "hydra with a bracketed IPv6 target first",
    "text": "hydra [::1] ssh -l root -P pw.txt",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "hydra with a numeric option first",
    "text": "hydra -6 -l root -P pw.txt ssh://host.example",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "hydra.exe with a flag",
    "text": "hydra.exe -l admin -P pw.txt ssh://host.example",
    "shouldMatch": true,
    "eventKind": "tool_use"
  },
  {
    "label": "hydra version number",
    "text": "hydra 2.2.0",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "Ory hydra token subcommand",
    "text": "hydra token client --endpoint http://localhost:4445",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "Medusa.js version check",
    "text": "medusa -v",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "hydra help alone",
    "text": "hydra -h",
    "shouldMatch": false,
    "eventKind": "tool_use"
  },
  {
    "label": "medusa with its -h host option",
    "text": "medusa -h 10.0.0.5 -u admin -P pw.txt -M ssh",
    "shouldMatch": true,
    "eventKind": "tool_use"
  }
]
