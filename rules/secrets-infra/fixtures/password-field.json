[
  {
    "label": "JSON password",
    "text": "{\"user\": \"admin\", \"password\": \"supersecret123\"}",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 31,
        "end": 45
      }
    ]
  },
  {
    "label": "JSON token",
    "text": "{\"name\": \"test\", \"token\": \"ghp_abc123def456\"}",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 27,
        "end": 43
      }
    ]
  },
  {
    "label": "JSON api key",
    "text": "{\"apiKey\": \"sk-proj-ABC123DEF456\"}",
    "shouldMatch": true
  },
  {
    "label": "spoken about password",
    "text": "The password is encrypted",
    "shouldMatch": false
  },
  {
    "label": "not a field value",
    "text": "password field",
    "shouldMatch": false
  },
  {
    "label": "short JSON password, value is the span",
    "text": "{\"password\": \"hunter2\"}",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 14,
        "end": 21
      }
    ]
  },
  {
    "label": "pass/fail status word",
    "text": "results[k] = ok ? 'pass': 'FAIL'",
    "shouldMatch": false
  },
  {
    "label": "type name as value",
    "text": "{\"token\": \"string\", \"required\": true}",
    "shouldMatch": false
  },
  {
    "label": "template variable, not a secret",
    "text": "{\"password\": \"${DB_PASSWORD}\"}",
    "shouldMatch": false
  },
  {
    "label": "angle-bracket placeholder, not a secret",
    "text": "password: \"<your-password>\"",
    "shouldMatch": false
  },
  {
    "label": "redacted marker, not a secret",
    "text": "{\"token\": \"redacted\"}",
    "shouldMatch": false
  },
  {
    "label": "literal password value",
    "text": "{\"password\": \"Tr0ub4dor3xyz\"}",
    "shouldMatch": true
  },
  {
    "label": "bcrypt hash value is a literal, not a template reference",
    "text": "{\"password\":\"$2b$10$N9qo8uLOickgx2ZMRZoMyeIjZAgcfl7p92ldGxad68LJZdL17lhWy\"}",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 13,
        "end": 73
      }
    ]
  },
  {
    "label": "argon2id hash value is a literal too",
    "text": "{\"password\":\"$argon2id$v=19$m=65536,t=3,p=4$c2FsdHNhbHRzYWx0c2FsdA\"}",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 13,
        "end": 66
      }
    ]
  },
  {
    "label": "quoted shell-style reference is still not a literal — only realized hash prefixes are exempted",
    "text": "{\"password\": \"$GH_TOKEN\"}",
    "shouldMatch": false
  }
]
