{
  "specVersion": 1,
  "id": "core-code-context/gcp-service-account-email",
  "name": "GCP service account email",
  "category": "code_context",
  "severity": "low",
  "matcher": {
    "type": "regex",
    "pattern": "(?<![a-z0-9-])[a-z0-9-]{3,}@[a-z0-9][a-z0-9-]{2,60}\\.iam\\.gserviceaccount\\.com\\b",
    "flags": "g"
  },
  "examples": [
    "deploy-bot@sample-project.iam.gserviceaccount.com",
    "12345678-1234-1234-1234-123456789012@my-project.iam.gserviceaccount.com"
  ]
}
