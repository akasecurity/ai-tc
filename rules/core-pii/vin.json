{
  "specVersion": 1,
  "id": "core-pii/vin",
  "name": "Vehicle Identification Number",
  "category": "pii",
  "severity": "medium",
  "matcher": {
    "type": "regex",
    "pattern": "(?<![.\\d])\\b(?=[A-HJ-NPR-Z0-9]{0,16}[A-HJ-NPR-Z])(?=[A-HJ-NPR-Z0-9]{0,16}\\d)[A-HJ-NPR-Z0-9]{17}\\b",
    "flags": "g"
  },
  "examples": [
    "1HGCM82633A004352"
  ]
}
