{
  "specVersion": 1,
  "id": "agent-harness-tamper/tool-output-outbound-call",
  "name": "Outbound call in a session where an MCP tool returned text",
  "category": "custom",
  "severity": "high",
  "matcher": {
    "type": "regex",
    "pattern": "^aka-session-state: mcp-output-in-session; outbound tool (?:mcp|Bash|WebFetch)$",
    "flags": ""
  },
  "examples": [
    "aka-session-state: mcp-output-in-session; outbound tool mcp",
    "aka-session-state: mcp-output-in-session; outbound tool Bash",
    "aka-session-state: mcp-output-in-session; outbound tool WebFetch"
  ],
  "appliesTo": {
    "eventKinds": ["tool_use"]
  }
}
