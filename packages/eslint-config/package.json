{
  "name": "@akasecurity/eslint-config",
  "version": "0.8.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.js",
    "./react": "./src/react.js"
  },
  "scripts": {
    "lint": "eslint src *.config.* && eslint --no-config-lookup -c eslint.guard.config.mjs test",
