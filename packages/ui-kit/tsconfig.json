{
  "extends": "../../tsconfig.base.json",
  "compilerOptions": {
    "noEmit": true,
    "jsx": "react-jsx"
  },
  // `test` joins `src` now the package has a suite. `rootDir` went with it: it
  // only ever constrained an output layout this package does not emit, and it
  // rejects an include that reaches outside itself.
  "include": ["src", "test"]
}
