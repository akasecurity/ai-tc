{
  "specVersion": 1,
  "id": "command-risk/credential-file-grep",
  "name": "Search or filter of a credential-bearing file",
  "category": "custom",
  "severity": "medium",
  "matcher": {
    "type": "regex",
    "pattern": "\\b(?:grep|egrep|fgrep|rg|ag|jq)(?<=(?:^|[;&|({\\x60]|\\$\\(|(?<![\\w.-])(?:bash|zsh|dash|ksh|csh|tcsh|fish|pwsh|sh)(?:[ \\t]+(?:-[A-Za-z]{1,8}(?:[ \\t]+[^\\s;|&\"'\\x60]{1,100})?|--[a-z][a-z-]{0,40}(?:=[^\\s;|&\"'\\x60]{1,100})?)){0,4}?[ \\t]+-[A-Za-z]*c[ \\t]+[\"']|(?:^|[;&|({\\x60]|\\$\\()[ \\t]*(?:eval(?:[ \\t]+[^\\s;|&\"'\\x60]{1,200}){0,6}?[ \\t]+[\"']|ssh(?:[ \\t]+-[^\\s]+(?:[ \\t]+[^\\s-][^\\s]*)?){0,6}[ \\t]+[^\\s;|&\"'-][^\\s;|&\"']{0,100}[ \\t]+[\"']?))[ \\t]*(?:(?:then|do|else|!)[ \\t]+)?(?:[A-Za-z_][A-Za-z0-9_]*=[^\\s;|&]{0,200}[ \\t]+){0,4}(?:(?:sudo|doas|env|command|exec|nohup|nice|time|xargs)(?:[ \\t]+[^\\s;|&\"'\\x60]{1,100}){0,4}?[ \\t]+)?(?:[\\w.~-]*/){0,8}(?:grep|egrep|fgrep|rg|ag|jq))(?![^;|&\\n]*?[ \\t](?:-[A-Za-z]*[cqlL][A-Za-z]*|--(?:count|quiet|silent|files-with-matches|files-without-match))(?=[ \\t]))[ \\t]+(?:-[^\\s;|&]*[ \\t]+){0,4}(?:\"[^\"]*\"|'[^']*'|[^\\s;|&\"'-][^\\s;|&]*)[ \\t]+(?:[^\\s;|&]{1,200}[ \\t]+){0,8}?[\"']?(?:[^\\s;|&\"']*/)?(?:\\.env(?!\\.(?:example|sample|template|dist))(?:\\.[A-Za-z0-9_-]+)?|[A-Za-z0-9_-]*\\.env|\\.zshenv|\\.zshrc|\\.zprofile|\\.bashrc|\\.bash_profile|\\.netrc|\\.npmrc|\\.pgpass|\\.git-credentials|\\.aws/(?:credentials|config)|(?:[A-Za-z0-9_.-]*[_.-])?auth\\.json|\\.?credentials\\.json|id_(?:rsa|ed25519|ecdsa|dsa))(?=$|[\\s\"';|&)])",
    "flags": "gm"
  },
  "examples": [
    "grep -E \"^export\" ~/.zshenv",
    "rg -n TOKEN .env"
  ],
  "appliesTo": {
    "eventKinds": [
      "tool_use"
    ]
  }
}
