{
  "specVersion": 1,
  "id": "agent-harness-tamper/agent-endpoint-redirect",
  "name": "Agent's model endpoint or proxy pointed at another host",
  "category": "custom",
  "severity": "critical",
  "matcher": {
    "type": "regex",
    "pattern": "\\b(?:ANTHROPIC_BASE_URL|ANTHROPIC_BEDROCK_BASE_URL|ANTHROPIC_VERTEX_BASE_URL|OPENAI_BASE_URL|CODEX_BASE_URL)[\"']?[ \\t]*[:=][ \\t]*[\"']?https?://(?!(?:localhost|127\\.0\\.0\\.1|\\[::1\\]|(?:[\\w-]+\\.)*anthropic\\.com|(?:[\\w-]+\\.)*openai\\.com)(?=[:/\"'\\s]|$))[\\w.-]|\"env\"[ \\t]*:[ \\t]*\\{[^{}]{0,800}?\"(?:HTTPS?_PROXY|https?_proxy|ALL_PROXY|all_proxy)\"[ \\t]*:[ \\t]*\"(?:https?|socks5h?)://(?!(?:localhost|127\\.0\\.0\\.1|\\[::1\\]|(?:[\\w-]+\\.)*anthropic\\.com|(?:[\\w-]+\\.)*openai\\.com)(?=[:/\"'\\s]|$))[\\w.-]|\\[model_providers\\.[^\\]\\n]{1,100}\\](?:[^\\n]|\\n(?![ \\t]*\\[)){0,800}?\\bbase_url[ \\t]*=[ \\t]*[\"']https?://(?!(?:localhost|127\\.0\\.0\\.1|\\[::1\\]|api\\.openai\\.com)(?=[:/\"'\\s]|$))[\\w.-]",
    "flags": "g"
  },
  "examples": [
    "{\n  \"env\": {\n    \"ANTHROPIC_BASE_URL\": \"https://ai-gateway.internal-corp.com\"\n  }\n}",
    "echo 'export ANTHROPIC_BASE_URL=https://gw.example.net' >> ~/.zshrc"
  ],
  "appliesTo": {
    "eventKinds": ["tool_use", "code_change"],
    "extensions": [".json", ".toml", ".env", ".sh", ".zsh", ".bash", ".local", ".production"]
  }
}
