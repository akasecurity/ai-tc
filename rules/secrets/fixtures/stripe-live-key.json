[
  {
    "label": "Stripe secret live key",
    "text": "STRIPE_KEY=sk_live_aBcDeFgHiJkLmNoPqRsTuVwXyZ",
    "shouldMatch": true,
    "expectedVariableName": "STRIPE_KEY"
  },
  {
    "label": "Stripe publishable live key",
    "text": "pk_live_aBcDeFgHiJkLmNoPqRsTuVwXyZ",
    "shouldMatch": true,
    "expectedVariableName": null
  },
  {
    "label": "test key (not live)",
    "text": "sk_test_aBcDeFgHiJkLmNoPqRsTuVwXyZ",
    "shouldMatch": false
  },
  {
    "label": "too short",
    "text": "sk_live_short",
    "shouldMatch": false
  },
  {
    "label": "env assignment with a double-quoted key records the variable name",
    "text": "STRIPE_SECRET_KEY=\"sk_live_aB3dE5fG7hJ9kL2mN4pQ6rS8\"",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 19,
        "end": 51
      }
    ],
    "expectedVariableName": "STRIPE_SECRET_KEY"
  },
  {
    "label": "exported env assignment records the variable name",
    "text": "export STRIPE_SECRET_KEY=sk_live_aB3dE5fG7hJ9kL2mN4pQ6rS8",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 25,
        "end": 57
      }
    ],
    "expectedVariableName": "STRIPE_SECRET_KEY"
  },
  {
    "label": "spaced, single-quoted assignment records the variable name",
    "text": "STRIPE_SECRET_KEY = 'sk_live_aB3dE5fG7hJ9kL2mN4pQ6rS8'",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 21,
        "end": 53
      }
    ],
    "expectedVariableName": "STRIPE_SECRET_KEY"
  },
  {
    "label": "YAML mapping records the key name",
    "text": "stripe:\n  secret_key: sk_live_aB3dE5fG7hJ9kL2mN4pQ6rS8\n",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 22,
        "end": 54
      }
    ],
    "expectedVariableName": "secret_key"
  },
  {
    "label": "JSON member records the key name",
    "text": "{\"stripeSecretKey\": \"sk_live_aB3dE5fG7hJ9kL2mN4pQ6rS8\"}",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 21,
        "end": 53
      }
    ],
    "expectedVariableName": "stripeSecretKey"
  },
  {
    "label": "key passed as a bare argument records no name",
    "text": "stripe.charge(sk_live_aB3dE5fG7hJ9kL2mN4pQ6rS8)",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 14,
        "end": 46
      }
    ],
    "expectedVariableName": null
  },
  {
    "label": "TypeScript typed declaration records the variable, not the type",
    "text": "const stripeKey: string = \"sk_live_aBcDeFgHiJkLmNoPqRsTuVwXyZ\";",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 27,
        "end": 61
      }
    ],
    "expectedVariableName": "stripeKey"
  },
  {
    "label": "Python annotated assignment records the variable, not the type",
    "text": "STRIPE_SECRET_KEY: str = \"sk_live_aBcDeFgHiJkLmNoPqRsTuVwXyZ\"",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 26,
        "end": 60
      }
    ],
    "expectedVariableName": "STRIPE_SECRET_KEY"
  },
  {
    "label": "Kotlin typed declaration records the variable, not the type",
    "text": "val apiKey: String = \"sk_live_aBcDeFgHiJkLmNoPqRsTuVwXyZ\"",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 22,
        "end": 56
      }
    ],
    "expectedVariableName": "apiKey"
  },
  {
    "label": "Go typed declaration records the variable, not the type",
    "text": "var apiKey string = \"sk_live_aBcDeFgHiJkLmNoPqRsTuVwXyZ\"",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 21,
        "end": 55
      }
    ],
    "expectedVariableName": "apiKey"
  },
  {
    "label": "ternary branches never record the other literal as a name",
    "text": "const key = isProd ? \"Pr0dPassw0rd2024\" : \"sk_live_aBcDeFgHiJkLmNoPqRsTuVwXyZ\";",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 43,
        "end": 77
      }
    ],
    "expectedVariableName": null
  },
  {
    "label": "a ternary false branch records no name",
    "text": "a ? b : \"sk_live_aBcDeFgHiJkLmNoPqRsTuVwXyZ\"",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 9,
        "end": 43
      }
    ],
    "expectedVariableName": null
  },
  {
    "label": "prose before a colon records no name",
    "text": "my stripe key is: sk_live_aBcDeFgHiJkLmNoPqRsTuVwXyZ",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 18,
        "end": 52
      }
    ],
    "expectedVariableName": null
  },
  {
    "label": "an instruction before a colon records no name",
    "text": "Here, use this: sk_live_aBcDeFgHiJkLmNoPqRsTuVwXyZ",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 16,
        "end": 50
      }
    ],
    "expectedVariableName": null
  },
  {
    "label": "log output before a colon records no name",
    "text": "Invalid API Key provided: sk_live_aBcDeFgHiJkLmNoPqRsTuVwXyZ",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 26,
        "end": 60
      }
    ],
    "expectedVariableName": null
  },
  {
    "label": "a basic-auth user records no name",
    "text": "curl -u admin:sk_live_aBcDeFgHiJkLmNoPqRsTuVwXyZ https://api.stripe.com",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 14,
        "end": 48
      }
    ],
    "expectedVariableName": null
  },
  {
    "label": "a host before a colon records no name",
    "text": "https://example.com:sk_live_aBcDeFgHiJkLmNoPqRsTuVwXyZ",
    "shouldMatch": true,
    "expectedSpans": [
      {
        "start": 20,
        "end": 54
      }
    ],
    "expectedVariableName": null
  }
]
