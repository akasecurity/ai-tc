{
  "specVersion": 1,
  "id": "secrets-infra/ssh-private-key",
  "name": "SSH private key",
  "category": "secret",
  "severity": "critical",
  "matcher": {
    "type": "regex",
    "pattern": "-----BEGIN ((?:RSA |DSA |EC |OPENSSH |SSH2 |ENCRYPTED )?)PRIVATE KEY-----(?:(?:[A-Za-z0-9+/=\\r\\n\\\\]|-(?!-)|[ \\t](?=[\\s\\\\]|-----END|[A-Za-z0-9+/=]{16})|(?<=\\s|\\\\[nr]|[A-Za-z0-9+/=]{16})[ \\t](?=[A-Za-z0-9+/=]{1,15}(?:[\\r\\n\\\\]|[ \\t]*-----END))|(?:Proc-Type|DEK-Info):(?:[^\\r\\n\\\\-]|-(?!-)){0,200}(?=[\\r\\n\\\\]|-----END)){0,8000}?-----END \\1PRIVATE KEY-----|(?:(?:[ \\t]*(?:\\r?\\n|(?:\\\\r)?\\\\n)){1,2}[ \\t]*(?:(?:Proc-Type|DEK-Info):[^\\r\\n\\\\]{1,200}|[A-Za-z0-9+/=]{16,4096}(?=[ \\t]*(?:[\\r\\n\\\\\\\"',]|$)))){1,256})?",
    "flags": "g"
  },
  "examples": [
    "-----BEGIN RSA PRIVATE KEY-----\nMIIEpAIBAAKCAQEA...\n-----END RSA PRIVATE KEY-----"
  ]
}
